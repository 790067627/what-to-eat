<!-- 沉浸式插画导航栏：背景层与内容层分离，fixed 常驻不随页面滚动 -->
<view class="imm-nav" style="height: {{m.headerHeight}}px">
  <!-- 背景层：从屏幕顶 top:0 铺满，aspectFill 裁切不变形 -->
  <image wx:if="{{headerUrl}}" class="imm-nav-bg" src="{{headerUrl}}" mode="aspectFill" binderror="onError" />
  <!-- 轻白罩：保证标题/状态栏文字可读 -->
  <view class="imm-nav-veil"></view>
  <!-- 底部渐隐：融入页面底色 #FFF7FA -->
  <view class="imm-nav-fade"></view>
  <!-- 内容层：标题与胶囊垂直对齐，水平居中 -->
  <view class="imm-nav-title" style="top: {{m.titleTop}}px; height: {{m.titleHeight}}px; line-height: {{m.titleHeight}}px">{{title}}</view>
</view>
