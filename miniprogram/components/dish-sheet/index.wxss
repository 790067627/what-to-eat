/* dish-sheet — 方案 A POC .sheet 逐值移植（390 视口 px×2=rpx）
 * POC：max-height 78% / radius 24px / padding 12px 20px calc(24px+safe)
 *      入场 transform .42s cubic-bezier(.32,1.25,.42,1)；遮罩 .3s */

.ds-mask {
  position: fixed; inset: 0; z-index: 1000;   /* 高于自定义 TabBar(999)，抽屉需盖住它 */
  background: rgba(1, 4, 9, 0.6);            /* POC .scrim */
  opacity: 0; transition: opacity 300ms;
}
.ds-mask.on { opacity: 1; }

/* 拖拽跟手外层：仅承载下拉位移（无 transition，纯跟手）；fixed 定位在此层 */
.ds-drag {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 1001;
}
.ds-sheet {
  position: relative;
  max-height: 78%;                            /* POC max-height:78%（页面按 78% 可用高度传值） */
  border-radius: 48rpx 48rpx 0 0;             /* 24px */
  background: var(--bg-sheet, #161b22);
  box-shadow: 0 -24rpx 80rpx rgba(0,0,0,0.5); /* 0 -12px 40px */
  transform: translateY(102%);
  transition: transform 420ms cubic-bezier(.32,1.25,.42,1);   /* POC 原曲线 */
  padding: 24rpx 40rpx 0;
  overflow: hidden;
  display: flex; flex-direction: column;      /* 内容层 flex:1 + 操作层固定 */
}
.ds-sheet.on { transform: translateY(0); }

/* POC .grip：38x4px radius2 margin 2px auto 14px */
.ds-grip {
  width: 76rpx; height: 8rpx; border-radius: 4rpx;
  background: var(--grip-color, rgba(255,255,255,0.18));
  margin: 4rpx auto 28rpx;
}
/* 内容层：独立滚动，flex:1 吃掉剩余高度 */
.ds-scroll { flex: 1; min-height: 0; }

/* POC img.hero：aspect 4/3 radius 16px */
.ds-hero {
  width: 100%; aspect-ratio: 4 / 3;
  border-radius: 32rpx;
  background: var(--bg-sunken, #0d1117);
}
.ds-hero-ph { background: var(--bg-placeholder, #21262d); }

/* POC h2 22px margin-top 14px；.meta 11px mt4；.desc 13px lh1.7 mt10 */
.ds-name { font-size: 44rpx; font-weight: 700; margin-top: 28rpx; color: var(--text-primary, #e6edf3); }
.ds-meta { font-size: 22rpx; color: var(--text-hint, #8b949e); margin-top: 8rpx; }
.ds-desc { font-size: 26rpx; line-height: 1.7; color: var(--text-secondary, #c9d5e3); margin-top: 20rpx; }

/* 标签行 */
.ds-tags { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 14rpx; }
.ds-chip {
  padding: 6rpx 18rpx; border-radius: 14rpx;
  background: var(--bg-sunken, #21262d);
  border: 1rpx solid var(--border-soft, rgba(255,255,255,0.1));
  font-size: 22rpx; color: var(--text-secondary, #c9d5e3); font-weight: 600;
}

/* 底部操作层：固定不滚，安全区让位（POC .row + safe-area） */
.ds-actions {
  flex: none;
  display: flex; gap: 20rpx;
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-sheet, #161b22);
}
.ds-act {
  flex: 1;
  flex: 1;
  height: 96rpx;                               /* 48px */
  border-radius: 48rpx;                        /* 24px */
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700;
  color: var(--text-primary, #e6edf3);
  background: var(--bg-hover, rgba(255,255,255,0.06));
  border: 2rpx solid var(--border-default, rgba(255,255,255,0.14));
}
.ds-act.on { color: #ff5a79; border-color: #ff5a79; background: rgba(255,90,121,0.12); }
.ds-act.primary {
  color: var(--text-on-accent, #fff);
  background: var(--gradient-primary, linear-gradient(135deg,#238636,#2ea043));
  border-color: transparent;
}
.ds-act.primary.added { color: #3fb950; border-color: #3fb950; background: rgba(63,185,80,0.12); }
