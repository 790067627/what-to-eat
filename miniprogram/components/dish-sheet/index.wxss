/* components/dish-sheet/index.wxss — 底部详情抽屉（方案 A 视觉冻结项，不允许重新设计）
 * 遮罩淡入 300ms；抽屉上滑 420ms cubic-bezier(.32,1.25,.42,1)（过冲回弹）；关闭回落 300ms。 */

.ds-mask {
  position: fixed;
  inset: 0;
  z-index: 900;
  background: var(--mask-heavy, rgba(20,6,16,0.55));
  opacity: 0;
  transition: opacity 300ms;
}
.ds-mask.on { opacity: 1; }

.ds-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 901;
  max-height: 82vh;
  border-radius: 44rpx 44rpx 0 0;
  background: var(--bg-sheet, #FFFFFF);
  box-shadow: 0 -24rpx 80rpx rgba(0,0,0,0.3);
  transform: translateY(102%);
  transition: transform 420ms cubic-bezier(.32,1.25,.42,1);
  padding-bottom: env(safe-area-inset-bottom);
}
.ds-sheet.on { transform: translateY(0); }

.ds-grip {
  width: 76rpx; height: 8rpx;
  border-radius: 4rpx;
  background: var(--border-strong, #F0C0D4);
  margin: 16rpx auto 8rpx;
}
.ds-scroll { max-height: calc(82vh - 40rpx); padding: 0 40rpx 40rpx; }

.ds-hero {
  width: 100%;
  aspect-ratio: 4 / 3;
  border-radius: 32rpx;
  margin-top: 16rpx;
  background: var(--bg-sunken, #FDF5F9);
}
.ds-hero-ph { background: var(--bg-placeholder, #FFEAF2); }

.ds-src {
  margin-top: 20rpx;
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: var(--text-hint, #C9A8B8);
}
.ds-name {
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  color: var(--text-primary, #4A2C3A);
  margin-top: 6rpx;
}

.ds-reason {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: var(--bg-glass, rgba(255,255,255,0.72));
  border: 1rpx dashed var(--color-accent-border, #FFD6E7);
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}
.ds-ai-mark {
  flex: none;
  margin-top: 2rpx;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--text-on-accent, #FFFFFF);
  background: var(--gradient-primary, linear-gradient(135deg, #FFB3D1, #FF8FB8));
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}
.ds-reason-txt {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--text-secondary, #9C7B8C);
}

.ds-kv {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.ds-cell {
  width: calc(50% - 9rpx);
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: var(--bg-sunken, #FDF5F9);
  border: 1rpx solid var(--border-soft, #FCEFF5);
}
.ds-k { font-size: 20rpx; letter-spacing: 2rpx; color: var(--text-hint, #C9A8B8); }
.ds-v {
  font-size: 26rpx; font-weight: 700; margin-top: 6rpx;
  color: var(--text-primary, #4A2C3A);
}
.ds-tags { display: flex; gap: 8rpx; flex-wrap: wrap; }
.ds-chip {
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: var(--bg-card-solid, #FFFFFF);
  border: 1rpx solid var(--border-soft, #FCEFF5);
  font-size: 21rpx;
  color: var(--text-secondary, #9C7B8C);
  font-weight: 600;
}

.ds-acts {
  margin-top: 28rpx;
  display: flex;
  gap: 20rpx;
  align-items: center;
}
.ds-round {
  width: 96rpx; height: 96rpx;
  flex: none;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
  color: var(--text-secondary, #9C7B8C);
  background: var(--bg-sunken, #FDF5F9);
  border: 2rpx solid var(--border-soft, #FCEFF5);
}
.ds-round.on { color: #FF5A79; border-color: #FF5A79; }
.ds-primary {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 29rpx; font-weight: 800; letter-spacing: 1rpx;
  color: var(--text-on-accent, #FFFFFF);
  background: var(--gradient-primary, linear-gradient(135deg, #FFB3D1, #FF8FB8));
  box-shadow: var(--shadow-accent, 0 16rpx 48rpx rgba(240,99,156,0.5));
}
.ds-primary.added {
  background: none;
  color: var(--color-success, #639922);
  border: 2rpx solid var(--color-success, #639922);
  box-shadow: none;
}
