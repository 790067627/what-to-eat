<!-- dish-sheet — 三层结构：遮罩 / 独立 scroll-view 内容 / 固定操作层
     关闭通道：①遮罩点击（立即反向退出）②顶部拖拽热区下拉（WXS 跟手+JS 决策）
     手势隔离：页面侧 interactionLocked 锁卡栈；本组件所有触摸节点 catch 防穿透 -->
<wxs src="./sheet-drag.wxs" module="drag" />

<!-- 遮罩：点击关闭。不可 catchtouchstart/touchend——catchtouchend 会吞掉框架
     tap 合成（与 card-stack 旧 bug 同根因）；catchtouchmove 已足够防滚动穿透 -->
<view
  wx:if="{{visible}}"
  class="ds-mask" style="{{maskStyle}}"
  catchtap="onMaskTap"
  catchtouchmove="noop"
></view>

<view
  wx:if="{{visible}}"
  class="ds-drag"
  style="{{dragStyle}}"
>
<view
  class="ds-sheet"
  style="max-height: {{sheetMaxH}}px"
  catchtap="noop"
  catchtouchmove="noop"
>
  <!-- 顶部拖拽热区：宽 100% 高 56px 透明区，WXS 手势捕获（不要求精准按住横线）；
       灰色横线视觉保持原样（长度/粗细/颜色/位置不变） -->
  <view
    class="ds-grip-zone"
    catchtouchstart="{{drag.touchStart}}"
    catchtouchmove="{{drag.touchMove}}"
    catchtouchend="{{drag.touchEnd}}"
    catchtouchcancel="{{drag.touchEnd}}"
  >
    <view class="ds-grip"></view>
  </view>

  <!-- 内容层：独立滚动，只滚图片/信息/理由 -->
  <scroll-view
    class="ds-scroll"
    scroll-y
    scroll-top="{{scrollTop}}"
    bindscroll="onScroll"
  >
    <block wx:if="{{item}}">
      <image
        wx:if="{{item.coverImageUrl || item.coverFileID}}"
        class="ds-hero"
        src="{{item.coverImageUrl || item.coverFileID}}"
        mode="aspectFill"
        bindtap="onPreviewImage"
      />
      <view wx:else class="ds-hero ds-hero-ph"></view>

      <view class="ds-name">{{item.name}}</view>
      <view class="ds-meta">{{item.type === 'public' ? '社区公开分享 · ' + (item.anonymous ? '匿名厨友' : item.author.nickname) + ' · ' + (item.likeCount || 0) + ' 赞' : '我的菜品库 · 我的评分 ' + (item.ratingText || item.rating || 0)}}</view>
      <view class="ds-tags" wx:if="{{item.tags.length}}">
        <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="ds-chip">{{tag}}</text>
      </view>
      <view class="ds-desc">{{item.reason}}</view>
    </block>
  </scroll-view>

  <!-- 底部操作层：固定，不参与滚动，安全区让位 -->
  <view class="ds-actions">
    <view class="ds-act {{item.liked ? 'on' : ''}}" bindtap="onLike">{{item.liked ? '♥ 已喜欢' : '♡ 喜欢'}}</view>
    <view class="ds-act primary {{item.saved ? 'added' : ''}}" bindtap="onWant">{{item.saved ? '✓ 已入想吃清单' : '＋ 想吃'}}</view>
  </view>
</view>
</view>
