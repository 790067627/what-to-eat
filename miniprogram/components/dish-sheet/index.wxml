<!-- dish-sheet — 方案 A POC 详情抽屉逐值移植（结构 = POC openSheet 生成序）：
     grip → hero(4:3) → h2 菜名 → meta 来源行 → desc 理由 → row 双按钮 -->
<view wx:if="{{visible}}" class="ds-mask {{entered ? 'on' : ''}}" bindtap="close" catchtouchmove="noop"></view>
<view wx:if="{{visible}}" class="ds-sheet {{entered ? 'on' : ''}}" catchtap="noop">
  <view class="ds-grip" bindtap="close"></view>
  <scroll-view class="ds-scroll" scroll-y>
    <block wx:if="{{item}}">
      <image
        wx:if="{{item.coverImageUrl || item.coverFileID}}"
        class="ds-hero"
        src="{{item.coverImageUrl || item.coverFileID}}"
        mode="aspectFill"
        bindtap="onPreviewImage"
      />
      <view wx:else class="ds-hero ds-hero-ph"></view>

      <view class="ds-name">{{item.name}}</view>
      <view class="ds-meta">{{item.type === 'public' ? '社区公开分享 · ' + (item.anonymous ? '匿名厨友' : item.author.nickname) + ' · ' + (item.likeCount || 0) + ' 赞' : '我的菜品库 · 站内 ' + (item.ratingText || item.rating || 0) + ' 分'}}</view>
      <view class="ds-desc">{{item.reason}}</view>

      <view class="ds-row">
        <view class="ds-act {{item.liked ? 'on' : ''}}" bindtap="onLike">{{item.liked ? '♥ 已喜欢' : '♡ 喜欢'}}</view>
        <view class="ds-act primary {{item.saved ? 'added' : ''}}" bindtap="onWant">{{item.saved ? '✓ 已入想吃清单' : '＋ 想吃'}}</view>
      </view>
    </block>
  </scroll-view>
</view>
