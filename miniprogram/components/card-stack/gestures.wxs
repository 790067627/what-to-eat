// components/card-stack/gestures.wxs — 手势层（视图线程执行，零 setData 跟手）
// 状态机：idle → dragging → settling → idle
//  - dragging：WXS 内联 setStyle 直接驱动前卡/后卡位移（不经过逻辑层）
//  - settling：松手同帧由 WXS 启动出场+补位终值动画，随后 callMethod('commitSwipe')
//  - 恢复协议（不依赖单一布尔回调）：JS 在提交成功/被拒/耗尽/重置的全部路径上
//    递增 releaseToken —— 单调递增保证 change: 必触发 → syncRelease 恢复 idle。
//    （旧方案的 locked 布尔镜像在「值不变」时 change: 不回调，会造成 settling 永久死锁）
//  - clearAll 竞态守卫：新一轮拖拽已开始（dragging）时跳过清理，内联样式归新拖拽所有
// 参数与方案 A POC 对齐：阈值 96px / 速度 0.55px/ms / 阻尼 260px / speed 420ms
var THRESH = 96;
var VELOCITY = 0.55;
var DAMP = 260;
var SETTLE_MS = '420ms';
var SPRING = 'cubic-bezier(.22,1.28,.36,1)';
var EXIT_EASE = 'cubic-bezier(.4,0,.7,.2)';

var state = {
  phase: 'idle',        // idle | dragging | settling
  uiLocked: false,      // 抽屉等外部交互锁（change:interaction-locked）
  startX: 0,
  startY: 0,
  dx: 0,
  lastX: 0,
  lastT: 0,
  startT: 0,
  vx: 0,
  moved: 0,
  horizontal: null,
  front: null,          // touchstart 缓存元素引用（每帧 selectComponent 是纯开销）
  behind: null
};

function frontOf(owner) { return owner.selectComponent('#cardFront'); }
function behindOf(owner) { return owner.selectComponent('#cardBehind'); }

/** change: 同步——外部交互锁（抽屉打开）。settling 不由此打断（动画归属 JS 生命周期） */
function syncUiLock(newValue) {
  state.uiLocked = !!newValue;
  if (state.uiLocked && state.phase === 'dragging') {
    // 拖拽中被上锁（如抽屉经其他路径打开）：释放引用，phase 归 idle
    state.front = null;
    state.behind = null;
    state.phase = 'idle';
  }
}

/** change: 同步——释放令牌（JS 全路径递增，值必变 → 回调必达）：
 *  settling → idle 的唯一恢复通道，兼做兜底（提交被拒/耗尽/组件重置同样走这里） */
function syncRelease() {
  if (state.phase === 'settling') state.phase = 'idle';
}

/** change: 同步——清理卡片内联样式，class 完全接管。
 *  竞态守卫：新拖拽已开始则跳过（内联样式已归新拖拽所有，其 touchEnd 自会再调度清理） */
function clearAll(newValue, oldValue, owner) {
  if (state.phase === 'dragging') return;
  var cards = owner.selectAll('.cs-card');
  if (cards && cards.length) {
    for (var i = 0; i < cards.length; i++) {
      cards[i].setStyle({ 'transform': '', 'transition': '', 'opacity': '' });
    }
  }
}

function onTouchStart(e, owner) {
  if (state.uiLocked || state.phase !== 'idle') return;
  var t = e.touches[0];
  state.phase = 'dragging';
  state.startX = t.clientX;
  state.startY = t.clientY;
  state.lastX = t.clientX;
  state.lastT = e.timeStamp;
  state.startT = e.timeStamp;
  state.dx = 0;
  state.vx = 0;
  state.moved = 0;
  state.horizontal = null;
  // 缓存引用 + 关过渡保证跟手
  state.front = frontOf(owner);
  state.behind = behindOf(owner);
  if (state.front) state.front.setStyle({ 'transition': 'none' });
  if (state.behind) state.behind.setStyle({ 'transition': 'none' });
}

function onTouchMove(e, owner) {
  if (state.phase !== 'dragging') return;
  var t = e.touches[0];
  var rawX = t.clientX - state.startX;
  var rawY = t.clientY - state.startY;

  // 方向锁定：首段 10px 判定横/纵，纵向放行（页面滚动不受影响）
  if (state.horizontal === null) {
    if (Math.abs(rawX) < 10 && Math.abs(rawY) < 10) return;
    state.horizontal = Math.abs(rawX) > Math.abs(rawY);
    if (!state.horizontal) { state.phase = 'idle'; return; }
  }

  var now = e.timeStamp;
  var dt = now - state.lastT;
  if (dt > 0) state.vx = (t.clientX - state.lastX) / dt;
  state.lastX = t.clientX;
  state.lastT = now;

  var a = rawX > 0 ? rawX : -rawX;
  if (a > DAMP) { a = DAMP + (a - DAMP) * 0.4; }
  state.dx = rawX > 0 ? a : -a;
  var ab = state.dx > 0 ? state.dx : -state.dx;
  state.moved = ab;

  // 前卡跟手（Swiper cards 拖拽公式简化）：translateX 全跟手 + 钟形旋转/缩放
  var prog0 = ab / THRESH;
  if (prog0 > 1) prog0 = 1;
  var dev = (prog0 - 0.5) / 0.5;
  var tBell = Math.sqrt(1 - dev * dev);
  if (state.front) {
    var rot = state.dx < 0 ? (-14 * tBell) : (14 * tBell);
    state.front.setStyle({
      'transform': 'translate3d(' + state.dx + 'px,0,0) rotate(' + rot + 'deg) scale(' + (1 - 0.06 * tBell) + ')'
    });
  }
  // 后卡补位预览：从 depth-1 槽位(14px/.92/-2.5°)随进度趋近 depth-0
  if (state.behind) {
    state.behind.setStyle({
      'transform': 'translate3d(' + (14 * (1 - prog0)) + 'px,0,0) scale(' + (0.92 + 0.08 * prog0) + ') rotate(' + (-2.5 * (1 - prog0)) + 'deg)'
    });
  }
}

function onTouchEnd(e, owner) {
  // touchcancel（来电/系统手势打断）与 touchend 同路径：dragging 才处理，天然幂等
  if (state.phase !== 'dragging') return;

  var ab = state.dx > 0 ? state.dx : -state.dx;
  var v = state.vx > 0 ? state.vx : -state.vx;
  var commit = ab > THRESH || v > VELOCITY;
  var dir = state.dx < 0 ? -1 : 1;
  var dur = e.timeStamp - state.startT;

  // tap 判定：位移 ≤10px 且 <400ms（catchtouchend 吞掉框架 tap 合成，需主动 callMethod）
  if (!commit && ab <= 10 && dur < 400 && state.horizontal !== false) {
    state.phase = 'idle';
    if (state.front) state.front.setStyle({ 'transform': '', 'transition': '' });
    if (state.behind) state.behind.setStyle({ 'transform': '', 'transition': '' });
    state.front = null; state.behind = null;
    owner.callMethod('dragMoved', { moved: 0 });
    owner.callMethod('onCardTap');
    state.moved = 0;
    return;
  }

  if (commit) {
    // ===== settling：松手同帧在视图层启动终值动画，不等 JS 往返 =====
    state.phase = 'settling';
    var exitX = dir < 0 ? '-120%' : '120%';
    var exitRot = dir < 0 ? '-13deg' : '13deg';
    if (state.front) {
      state.front.setStyle({
        'transform': 'translate3d(' + exitX + ',30px,0) scale(0.92) rotate(' + exitRot + ')',
        'opacity': '0',
        'transition': 'transform ' + SETTLE_MS + ' ' + EXIT_EASE + ', opacity 340ms linear'
      });
    }
    if (state.behind) {
      state.behind.setStyle({
        'transform': 'translate3d(0,0,0) scale(1) rotate(0deg)',
        'transition': 'transform ' + SETTLE_MS + ' ' + SPRING
      });
    }
    state.front = null; state.behind = null;
    owner.callMethod('dragMoved', { moved: state.moved });
    // 提交协议：JS 无论接受/拒绝此次提交，都必须递增 releaseToken（→ syncRelease 恢复 idle）；
    // 拒绝时 JS 同时递增 clearToken → clearAll 清除出场内联样式，卡片经 class 过渡弹回
    owner.callMethod('commitSwipe', { dir: dir });
  } else {
    // ===== 未过阈值：回弹到各自 depth 槽位 =====
    state.phase = 'idle';
    if (state.front) {
      state.front.setStyle({
        'transition': 'transform ' + SETTLE_MS + ' ' + SPRING,
        'transform': 'translate3d(0,0,0) rotate(0deg) scale(1)'
      });
    }
    if (state.behind) {
      state.behind.setStyle({
        'transition': 'transform ' + SETTLE_MS + ' ' + SPRING,
        'transform': 'translate3d(14px,0,0) scale(0.92) rotate(-2.5deg)'
      });
    }
    state.front = null; state.behind = null;
    // 回弹完成后延迟清内联，让 class 接管（值一致，视觉无感；dragging 守卫防竞态）
    owner.callMethod('scheduleClear');
    owner.callMethod('dragMoved', { moved: 0 });
  }
  state.moved = 0;
}

module.exports = {
  touchStart: onTouchStart,
  touchMove: onTouchMove,
  touchEnd: onTouchEnd,
  syncUiLock: syncUiLock,
  syncRelease: syncRelease,
  clearAll: clearAll,
  // 测试探针：自动化用例断言/复位状态机用，业务代码不得依赖
  _peek: function () { return { phase: state.phase, uiLocked: state.uiLocked }; },
  _reset: function () {
    state.phase = 'idle'; state.uiLocked = false; state.dragging = false;
    state.dx = 0; state.vx = 0; state.moved = 0; state.horizontal = null;
    state.front = null; state.behind = null;
  }
};
