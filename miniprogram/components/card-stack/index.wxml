<!-- components/card-stack/index.wxml — 方案 A 卡栈（节点恒定，布局态/内容分离） -->
<wxs src="./gestures.wxs" module="gestures" />

<!-- WXS 状态同步节点（change: 官方机制）：
     uiLocked=抽屉交互锁 / releaseToken=settling 释放令牌（递增必触发，杜绝死锁）
     / clearToken=内联样式清理（WXS 内有 dragging 竞态守卫） -->
<view class="lock-sync"
  interaction-locked="{{interactionLocked}}" change:interaction-locked="{{gestures.syncUiLock}}"
  release-token="{{releaseToken}}" change:release-token="{{gestures.syncRelease}}"
  clear-token="{{clearToken}}" change:clear-token="{{gestures.clearAll}}"
  debug="{{debug}}" change:debug="{{gestures.syncDebug}}"
></view>

<view class="stack-host">
  <view
    class="stack"
    catchtouchstart="{{gestures.touchStart}}"
    catchtouchmove="{{gestures.touchMove}}"
    catchtouchend="{{gestures.touchEnd}}"
    catchtouchcancel="{{gestures.touchEnd}}"
    bindlongpress="onCardLongPress"
  >
    <!-- 节点恒定：key=type:id 不含游标；renderList 仅布局态，内容经 cardsMap[key] 引用。
         后卡弱化靠 veil/overlay 的 class 过渡（无节点增删、无图片重载） -->
    <block wx:for="{{renderList}}" wx:key="key">
      <!-- 无动态 id：WXS 经 selectAll('.cs-card')+hasClass('depth-N') 按视图层真实
           class 定位前卡/后卡（class 与 setData patch 同帧生效，不受 id 更新时序影响） -->
      <view
        class="cs-card depth-{{item.depth}} {{item.exiting ? ('exit-' + item.exitDir) : ''}}"
      >
        <block wx:if="{{cardsMap[item.key]}}">
          <view class="cs-photo">
            <image
              wx:if="{{cardsMap[item.key].coverImageUrl || cardsMap[item.key].coverFileID}}"
              class="cs-img"
              src="{{cardsMap[item.key].coverImageUrl || cardsMap[item.key].coverFileID}}"
              mode="aspectFill"
            />
            <view wx:else class="cs-img cs-img-ph"></view>
            <!-- 后卡压暗 veil（POC ::before 深色 overlay，class 过渡） -->
            <view class="cs-veil"></view>
            <!-- 底部渐变压暗（POC .card-photo::after） -->
            <view class="cs-photo-shade"></view>

            <!-- 顶部双徽章（POC photo-badges）：后卡经 .cs-overlay 透明度隐藏 -->
            <view class="cs-badges cs-overlay">
              <view class="cs-badge" wx:if="{{cardsMap[item.key].type === 'public'}}">♥ {{cardsMap[item.key].likeCount}} 赞 · 社区</view>
              <view class="cs-badge" wx:else>★ 我的评分 {{cardsMap[item.key].ratingText}} · 私有</view>
              <view class="cs-badge">{{cardsMap[item.key].type === 'public' ? '来自 ' + cardsMap[item.key].author.nickname : '我的菜品库'}}</view>
            </view>
            <!-- 菜名 + 副行：压照片底部（POC card-title-overlay） -->
            <view class="cs-title-wrap cs-overlay">
              <view class="cs-title">{{cardsMap[item.key].name}}</view>
              <view class="cs-subtitle">{{cardsMap[item.key].type === 'public' ? cardsMap[item.key].author.nickname + ' 的公开分享' : '你的菜品库 · 点击看详情'}}</view>
            </view>
          </view>

          <!-- 信息条：AI 理由单块（POC card-info） -->
          <view class="cs-info cs-overlay">
            <view class="cs-reason">
              <text class="cs-ai-mark">AI</text>
              <text class="cs-reason-txt">{{cardsMap[item.key].reason}}</text>
            </view>
          </view>
        </block>
      </view>
    </block>

    <!-- 加载/空态 -->
    <view wx:if="{{loading}}" class="cs-loading">
      <view class="cs-loading-text">正在为你挑菜…</view>
    </view>
  </view>
</view>
