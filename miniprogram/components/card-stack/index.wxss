/* components/card-stack/index.wxss — 方案 A 卡栈视觉
 * 几何与 POC 对齐：4 层卡栈、后卡 (15,13)/(−17,25)/(19,36) 错位、主卡唯一清晰。
 * 颜色全部语义 Token（规范 4.0），回退值为樱花粉基线。
 * 组件在页面内（page-meta 变量穿透继承），策略 A 纯继承，不自带订阅。 */

.stack-host {
  position: relative;
  width: 100%;
  height: 100%;
}
.stack {
  position: absolute;
  inset: 0;
}

/* ===== 卡片基座 ===== */
.cs-card {
  position: absolute;
  left: 50%;
  top: 0;
  width: 86%;
  height: 100%;
  margin-left: -43%;
  border-radius: 44rpx;
  background: var(--bg-card-solid, #FFFFFF);          /* 不透明：杜绝后方照片穿透 */
  border: 2rpx solid var(--border-default, #F8E3EC);
  box-shadow: var(--shadow-card-heavy, 0 60rpx 140rpx rgba(14,2,10,0.62));
  overflow: hidden;
  will-change: transform;
  transition: transform 560ms cubic-bezier(.22,1.28,.36,1), opacity 420ms;
}

/* 层级几何（与 POC POS 数组一致，px→rpx ×2 视觉等效，容器内用 px 值） */
.depth-0 { z-index: 10; transform: translate3d(0,0,0) scale(1) rotate(0deg); }
.depth-1 { z-index: 9;  transform: translate3d(15px,13px,0) scale(0.965) rotate(1.4deg); opacity: 0.85; }
.depth-2 { z-index: 8;  transform: translate3d(-17px,25px,0) scale(0.93) rotate(-1.8deg); opacity: 0.6; }
.depth-3 { z-index: 7;  transform: translate3d(19px,36px,0) scale(0.9) rotate(2.2deg); opacity: 0.4; }

/* 出场：倾斜滑出（方案 A：400ms rotate 13°） */
.exit-left  { transform: translate3d(-120%,30px,0) scale(0.92) rotate(-13deg) !important; opacity: 0 !important; transition: transform 400ms cubic-bezier(.4,0,.7,.2), opacity 340ms !important; }
.exit-right { transform: translate3d(120%,30px,0) scale(0.92) rotate(13deg) !important;  opacity: 0 !important; transition: transform 400ms cubic-bezier(.4,0,.7,.2), opacity 340ms !important; }

/* ===== 照片层 ===== */
.cs-photo {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 184rpx;   /* 底部留出信息层 */
  background: var(--bg-sunken, #FDF5F9);
}
.cs-img { width: 100%; height: 100%; display: block; }
.cs-img-ph { background: var(--bg-placeholder, #FFEAF2); }

/* 后卡弱化遮罩：任何时刻只有主卡照片清晰 */
.cs-veil {
  position: absolute; inset: 0;
  background: var(--bg-card-solid, #FFFFFF);
  opacity: 0.88;
}
.depth-2 .cs-veil, .depth-3 .cs-veil { opacity: 0.96; }

/* 主卡底部渐变压暗（标签/菜名可读） */
.cs-photo-shade {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(8,10,14,0.42) 100%);
}

/* ===== 悬浮标签（仅主卡渲染） ===== */
.cs-tag {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--bg-glass, rgba(255,255,255,0.72));
  border: 1rpx solid var(--glass-border, rgba(255,255,255,0.4));
  box-shadow: 0 6px 18px rgba(0,0,0,0.18);
  font-size: 21rpx;
  font-weight: 700;
  color: var(--text-primary, #4A2C3A);
  white-space: nowrap;
}
.cs-tag-match { left: -10rpx; top: 18%; color: var(--color-accent-strong, #E85D91); }
.cs-pip {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--color-accent, #FF8FB8);
  box-shadow: 0 0 0 5rpx rgba(var(--glow-rgb, 255,143,184), 0.25);
}
.cs-tag-likes { right: -6rpx; top: 18%; color: #FF5A79; }
.cs-tag-src {
  left: 24rpx; bottom: 92rpx;
  padding: 8rpx 16rpx 8rpx 10rpx;
  color: var(--text-secondary, #9C7B8C);
  font-weight: 600;
}
.cs-src-avatar { width: 36rpx; height: 36rpx; border-radius: 50%; flex: none; }

/* 菜名：大字压照片底部 */
.cs-title {
  position: absolute;
  left: 32rpx; right: 32rpx; bottom: 16rpx;
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
  color: #FFFFFF;
  text-shadow: 0 2px 14px rgba(0,0,0,0.55), 0 1px 2px rgba(0,0,0,0.4);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== 信息层：底部毛玻璃承载 AI 理由 ===== */
.cs-info {
  position: absolute;
  left: 16rpx; right: 16rpx; bottom: 16rpx;
  height: 152rpx;
  padding: 16rpx 20rpx;
  border-radius: 28rpx;
  background: var(--bg-glass, rgba(255,255,255,0.72));
  border: 1rpx solid var(--glass-border, rgba(255,255,255,0.4));
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.cs-reason {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--text-secondary, #9C7B8C);
}
.cs-reason-txt {
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.cs-ai-mark {
  flex: none;
  margin-top: 2rpx;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--text-on-accent, #FFFFFF);
  background: var(--gradient-primary, linear-gradient(135deg, #FFB3D1, #FF8FB8));
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}
.cs-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 21rpx;
  color: var(--text-hint, #C9A8B8);
}
.cs-meta-tags { display: flex; gap: 10rpx; overflow: hidden; }
.cs-chip {
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: var(--bg-sunken, #FDF5F9);
  border: 1rpx solid var(--border-soft, #FCEFF5);
  color: var(--text-secondary, #9C7B8C);
  font-weight: 600;
  white-space: nowrap;
}
.cs-detail-hint { color: var(--color-accent-strong, #E85D91); font-weight: 700; flex: none; }

/* ===== 加载态 ===== */
.cs-loading {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
}
.cs-loading-text { font-size: 26rpx; color: var(--text-hint, #C9A8B8); }
