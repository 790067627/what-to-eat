/* 首页 Hello Kitty 装饰图（樱花主题专属，theme-assets decoration.kitty 门控）
   - 文档流内独立装饰元素：位于分类速览模块之后，随内容自然排列，
     分类增减/屏幕尺寸变化均自动跟随（v1.6.0 起；旧版 fixed+z-index:-1 会被
     page-meta root-background-color 盖住，根因见规范文档 7.3）
   - 可调参数集中在 .kitty-wrap 变量：宽度 / 透明度
   - pointer-events:none 不挡任何点击（点击弹跳由页面级 tap 坐标命中检测触发，
     见 index.js onPageTap → tryTapBounce）
   - 三层嵌套分离 transform：wrap 定位 / float 漂浮 / sway 摇摆 / image 弹跳 */
:host { display: block; }

.kitty-wrap {
  /* 装饰图宽度（原图 1536x1024，widthFix 自动等比，高≈宽×2/3） */
  --kitty-width: 380rpx;
  --kitty-opacity: 0.92;

  display: flex;
  justify-content: center;
  width: 100%;
  /* 与分类速览拉开呼吸间距；底部让位由 .page 的 padding-bottom 统一负责，此处不加 */
  margin-top: 24rpx;
  pointer-events: none;
}

.kitty-deco {
  width: var(--kitty-width);
  display: block;
  opacity: var(--kitty-opacity);
}

/* ① 漂浮：3s 周期上下 6rpx，ease-in-out 无限循环 */
.kitty-float { animation: kittyFloat 3s ease-in-out infinite; }
@keyframes kittyFloat {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-6rpx); }
}

/* ② 摇摆：4s 周期 ±2°，与漂浮周期错开更自然 */
.kitty-sway { animation: kittySway 4s ease-in-out infinite; }
@keyframes kittySway {
  0%, 100% { transform: rotate(-2deg); }
  50%      { transform: rotate(2deg); }
}

/* ③ 点击弹跳：一次性 400ms 缩放，由 JS 加/摘 class 触发 */
.kitty-bounce { animation: kittyBounce 0.4s ease; }
@keyframes kittyBounce {
  0%   { transform: scale(1); }
  30%  { transform: scale(1.08); }
  60%  { transform: scale(0.97); }
  100% { transform: scale(1); }
}

/* 页面隐藏时暂停动画（pageLifetimes.hide 挂 .paused） */
.paused .kitty-float,
.paused .kitty-sway { animation-play-state: paused; }
