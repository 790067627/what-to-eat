@font-face {
  font-family: 'bi';
  src: url('data:font/truetype;charset=utf-8;base64,') format('truetype');
  font-weight: normal;
  font-style: normal;
}

/* Canvas 隐藏绘制区 */
.poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 375px;
  height: 500px;
}

/* 遮罩层 */
.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

/* 弹窗容器 */
.poster-box {
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 预览图 */
.poster-preview {
  width: 100%;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25);
  background: #FFFFFF;
  display: block;
}

/* 第一行：两个并排按钮 */
.poster-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
  width: 100%;
}

/* 分享给好友按钮（主按钮） */
.poster-btn-share {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #E894B0, #D4779A);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(212, 119, 154, 0.35);
  border: none;
  line-height: 1.4;
  margin: 0;
}

.poster-btn-share::after {
  border: none;
}

.poster-btn-share .bi {
  margin-right: 6rpx;
  font-size: 28rpx;
}

/* 保存到相册按钮（次按钮） */
.poster-btn-save {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  color: #fff;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.08);
}

.poster-btn-save .bi {
  margin-right: 6rpx;
  font-size: 28rpx;
}

.poster-btn-disabled { opacity: 0.5; }

/* 第二行：关闭按钮（文字样式） */
.poster-close {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  padding: 8rpx 32rpx;
}

.poster-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
}

.bi {
  font-family: 'bi' !important;
  font-style: normal;
  font-weight: normal;
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  -webkit-font-smoothing: antialiased;
}
