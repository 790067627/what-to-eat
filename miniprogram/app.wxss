/** 内联 Bootstrap Icons 子集，叶子从 U+F90C 重新映射到私用区 U+E000。 */
@font-face {
  font-family: 'bi';
  src: url('data:font/ttf;base64,') format('truetype');
  font-weight: normal;
  font-style: normal;
}
.bi {
  font-family: 'bi' !important;
  font-style: normal;
  font-weight: normal;
  display: inline-block;
  vertical-align: middle;
  line-height: 1;
  -webkit-font-smoothing: antialiased;
}

/**app.wxss - 全局公共组件层：布局/排版/通用件。
   颜色一律引用 theme/tokens.js 注入的语义变量（page-meta page-style 写入 page 根节点），
   var() 第二参为樱花粉回退值：page-meta 注入前首帧即为默认主题，无闪色。
   主题相关的动态值（阴影/渐变等）由各页面 wxss 引用，全局只保留跨页通用件。**/
page {
  --radius-lg: 28rpx;
  --radius-md: 20rpx;
  --radius-sm: 14rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: var(--text-primary, #4A2C3A);
  background-color: var(--bg-page, #FFF7FA);
  box-sizing: border-box;
}

view, text, image, scroll-view, input, textarea, button {
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: var(--bg-card, rgba(255, 255, 255, 0.88));
  border: 1rpx solid var(--card-border, rgba(255, 143, 184, 0.16));
  box-shadow: var(--shadow-card, 0 6rpx 24rpx rgba(217, 108, 153, 0.08));
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 主按钮 */
.btn-primary {
  background: var(--color-accent, #FF8FB8);
  color: var(--text-on-accent, #fff);
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}
.btn-primary::after { border: none; }
.btn-primary.btn-disabled {
  background: var(--btn-disabled-bg, #F5C9DD);
  color: var(--btn-disabled-text, #FFF0F6);
}

/* 次级按钮 */
.btn-ghost {
  background: var(--color-accent-soft, #FFF0F6);
  color: var(--color-accent, #FF8FB8);
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  text-align: center;
  display: inline-block;
}

/* 标签 chip */
.chip {
  display: inline-block;
  background: var(--color-accent-soft, #FFF0F6);
  color: var(--color-accent, #FF8FB8);
  font-size: 22rpx;
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
  margin: 0 10rpx 10rpx 0;
}
.chip-plain {
  background: var(--color-accent-softer, #FBEFF5);
  color: var(--text-secondary, #9C7B8C);
}
.chip-success {
  background: var(--color-success-bg, #EAF3DE);
  color: var(--color-success, #639922);
}

/* 区块标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary, #4A2C3A);
  margin: 8rpx 0 16rpx;
}

/* flex 工具类 */
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-v-center { display: flex; align-items: center; }

/* 单行/两行省略 */
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ellipsis-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; color: var(--text-hint, #C9A8B8); }
.empty-text { color: var(--text-hint, #C9A8B8); font-size: 26rpx; margin-bottom: 32rpx; }

/* 底部安全区 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 骨架屏 */
.skeleton-item {
  display: flex;
  gap: 20rpx;
  background: var(--bg-card, rgba(255, 255, 255, 0.88));
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.skeleton-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(90deg, var(--skeleton-base, #FBEFF5) 25%, var(--skeleton-shine, #FDF7FA) 50%, var(--skeleton-base, #FBEFF5) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}
.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--skeleton-base, #FBEFF5) 25%, var(--skeleton-shine, #FDF7FA) 50%, var(--skeleton-base, #FBEFF5) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
  margin-bottom: 16rpx;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
