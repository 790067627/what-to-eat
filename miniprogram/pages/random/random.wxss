/* ============ 页面骨架 ============ */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  /* border-box：100vh 含 padding。顶部让位导航（内联实测 navHeight）。
     底部避让 = TabBar 内容区 112rpx + 凸起上探 35rpx（TabBar 高度模型事实值）
     作为最小净空，呼吸增量用 clamp 随视口高度伸缩——小屏收紧、大屏适度放大；
     safe-area 由 env() 弹性提供。结果揭晓在全屏弹层内独立避让（.ov-spacer 实测） */
  padding: 0 24rpx calc(constant(safe-area-inset-bottom) + 147rpx + clamp(0rpx, 2vh, 40rpx));
  padding: 0 24rpx calc(env(safe-area-inset-bottom) + 147rpx + clamp(0rpx, 2vh, 40rpx));
}
/* 背景内容层：弹层打开时暗化模糊（filter 只作用于此，不含弹层）。
   本身不滚动：设置卡固定高度 + 抽取卡区(.idle-stage)内部自适应，
   滚动职责集中在 .idle-stage，避免双滚动容器嵌套 */
.page-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  transition: filter 0.4s ease;
}
.page-body.dimmed { filter: blur(14rpx) brightness(0.5) saturate(0.7); }

/* ============ ① 抽取设置：可折叠卡片 ============ */
.settings { flex-shrink: 0; padding: 0; overflow: hidden; }
.settings-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
}
.settings-head-hover { background: var(--bg-hover, rgba(255, 143, 184, 0.06)); }
.settings-titles { flex: 1; min-width: 0; }
.settings-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #4A2C3A);
}
.settings-summary {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-secondary, #9C7B8C);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 纯 CSS 箭头（无图标依赖），展开时旋转 180° */
.settings-arrow {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  border-right: 3rpx solid var(--text-hint, #C9A8B8);
  border-bottom: 3rpx solid var(--text-hint, #C9A8B8);
  transform: rotate(45deg) translate(-4rpx, -4rpx);
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}
.settings.open .settings-arrow { transform: rotate(225deg) translate(-4rpx, -4rpx); }
/* 折叠动画：grid-template-rows 0fr→1fr（内容自适应高度，无写死高度） */
.settings-body {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}
.settings.open .settings-body { grid-template-rows: 1fr; }
.settings-inner {
  min-height: 0;
  overflow: hidden;
  padding: 0 28rpx;
}
.settings.open .settings-inner { padding-bottom: 8rpx; }

/* 筛选行：行高统一 92rpx，行间细分割线，控件右缘对齐 */
.filter-row {
  display: flex;
  align-items: center;
  height: 92rpx;
}
.filter-row + .filter-row { border-top: 1rpx solid var(--border-soft, #FCEFF5); }
.filter-label { font-size: 26rpx; color: var(--text-primary, #4A2C3A); width: 260rpx; flex-shrink: 0; }
.filter-slider { flex: 1; margin: 0 20rpx; }
.filter-value { font-size: 26rpx; color: var(--color-accent, #FF8FB8); font-weight: 600; width: 100rpx; text-align: right; }
/* switch/picker 靠右对齐，与滑块行右侧区域对齐 */
.filter-row switch { transform: scale(0.84); transform-origin: right center; }
.filter-row picker { margin-left: auto; }
.filter-picker {
  font-size: 26rpx;
  color: var(--color-accent, #FF8FB8);
  background: var(--color-accent-soft, #FFF0F6);
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
}

/* ============ ② 抽取交互卡片（控制台视觉焦点） ============ */
/* 抽取卡区舞台：占满设置卡之外的全部剩余空间。
   收起态——内容不足，auto margin 垂直安全居中（大屏不过度空旷）；
   展开态——设置卡占去较多高度，小屏剩余空间不足以容纳完整卡片，
   此时切换为顶部对齐 + 紧凑抽取卡 + 区域自身滚动，保证「开始抽取」
   主按钮始终在首屏可见、绝不被裁切（规避 justify-content:center 顶部盲区）。 */
.idle-stage {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: clamp(8rpx, 2vh, 36rpx) 0;
}
.roll-card {
  width: 100%;
  text-align: center;
  padding: clamp(28rpx, 4.5vh, 72rpx) 40rpx clamp(32rpx, 5vh, 68rpx);
  margin-top: auto;     /* 与 .add-hint 的 margin-bottom:auto 配对实现安全居中 */
  margin-bottom: 0;
  flex-shrink: 0;
}
.dice { font-size: 120rpx; margin-bottom: 20rpx; color: var(--color-accent, #FF8FB8); animation: float 2.4s ease-in-out infinite; }
/* 开始抽取按钮：距说明弹性留白（48~64rpx 基准，随视口高度微调） */
.roll-btn { width: 70%; margin: clamp(40rpx, 5vh, 64rpx) auto 0; }
.add-hint {
  margin-top: clamp(20rpx, 3vh, 40rpx);
  margin-bottom: auto;    /* 与 .roll-card 的 margin-top:auto 配对，安全居中 */
  padding: 12rpx 24rpx;   /* 扩大点按热区，视觉仍是轻量文字 */
  font-size: 24rpx;
  color: var(--text-hint, #C9A8B8);
  text-align: center;
  flex-shrink: 0;
}

/* 设置展开态：中小屏剩余空间不足以容纳完整抽取卡，切换紧凑卡，
   保证主按钮与次级入口同屏完整可见、不裁切；大屏（视口高>880px）保留完整卡。
   居中仍由 auto margin 承担：内容放得下即居中，放不下自动顶对齐+本区滚动。 */
@media (max-height: 880px) {
  .settings-open .roll-card { padding: 16rpx 40rpx 20rpx; }
  .settings-open .dice { font-size: 84rpx; margin-bottom: 8rpx; }
  .settings-open .idle-title { font-size: 32rpx; }
  .settings-open .idle-sub { font-size: 24rpx; margin-top: 6rpx; }
  .settings-open .roll-btn { margin-top: 24rpx; }
  .settings-open .add-hint { margin-top: 12rpx; padding: 6rpx 24rpx; }
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}
.idle-title { font-size: 40rpx; font-weight: 600; color: var(--text-primary, #4A2C3A); }
.idle-sub { font-size: 26rpx; color: var(--text-hint, #C9A8B8); margin-top: 12rpx; }
.error-tip {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--color-accent-deep, #D96C99);
  background: var(--color-accent-soft, #FFF0F6);
  border-radius: 16rpx;
  padding: 14rpx 28rpx;
  display: inline-block;
}

/* ============ 全屏沉浸揭晓弹层 ============
   z-index 1000：盖过 nav(900) 与自定义 TabBar(999) */
.ov {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}
.ov.in { opacity: 1; pointer-events: auto; display: flex; flex-direction: column; }
/* 上下占位：高度由 JS 实测 T/B 动态写入（导航底边 / 窗口高-TabBar凸起顶边） */
.ov-spacer { flex: none; width: 100%; }
/* 可用区 H=B-T：内容在其中 flex 居中；极小屏内容超高时整体滚动（卡片内部不滚） */
.ov-body {
  position: relative;
  z-index: 5;
  flex: 1;
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow-y: auto;
  padding: 0 24rpx;
}
.ov-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--gradient-overlay, radial-gradient(130% 95% at 50% 34%, rgba(78,30,52,0.58), rgba(32,10,24,0.86)));
}
/* 粒子层：canvas 必须显式 width/height，防替换元素尺寸失控（POC 踩坑） */
.fx {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  pointer-events: none;
}

/* 舞台：自然高度，卡片水平居中 */
.ov-stage {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
}
.ov-stage.zoompunch { animation: zoomPunch 0.4s cubic-bezier(0.2,1.4,0.4,1); }
@keyframes zoomPunch { 0% { transform: scale(1.045); } 100% { transform: scale(1); } }

/* ============ 卡牌（3D 翻牌；transform 全部由 JS 逐帧驱动） ============ */
.card-zone { width: 616rpx; position: relative; }
.card-inner {
  position: relative;
  width: 100%;
  transform-style: preserve-3d;
}
/* 卡面进正常流：内容自然撑高卡片，文字不裁切 */
.face-front {
  position: relative;
  width: 100%;
  border-radius: 52rpx;
  overflow: hidden;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
/* 卡背绝对覆盖，高度跟随卡面 */
.face-back {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 52rpx;
  overflow: hidden;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
/* ---- 卡背：主题纹样（樱花粉 / GitHub 蓝） ---- */
.face-back {
  transform: rotateY(180deg);
  background:
    radial-gradient(circle at 22% 18%, var(--card-back-pattern, rgba(255,214,231,0.5)) 0 12rpx, transparent 14rpx),
    radial-gradient(circle at 78% 30%, var(--card-back-pattern, rgba(255,214,231,0.42)) 0 10rpx, transparent 12rpx),
    radial-gradient(circle at 30% 76%, var(--card-back-pattern, rgba(255,214,231,0.4)) 0 14rpx, transparent 16rpx),
    radial-gradient(circle at 74% 84%, var(--card-back-pattern, rgba(255,214,231,0.5)) 0 10rpx, transparent 12rpx),
    radial-gradient(circle at 50% 48%, var(--card-back-pattern-soft, rgba(255,240,247,0.35)) 0 24rpx, transparent 28rpx),
    var(--gradient-card-back, linear-gradient(160deg, #E85D91 0%, #C74B7C 46%, #8E2F58 100%));
  border: 3rpx solid var(--card-back-emblem-border, rgba(255,190,216,0.55));
  box-shadow: var(--card-back-shadow, 0 52rpx 128rpx rgba(14,2,10,0.6), inset 0 2rpx 0 rgba(255,255,255,0.28), inset 0 0 80rpx rgba(80,10,40,0.4));
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-emblem {
  width: 208rpx; height: 208rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 104rpx;
  color: var(--card-back-emblem, #FFEAF3);
  background: var(--card-back-inner, radial-gradient(circle at 34% 30%, rgba(255,255,255,0.3), rgba(255,255,255,0.08)));
  border: 4rpx solid var(--card-back-emblem-border, rgba(255,222,236,0.65));
  box-shadow: 0 0 60rpx var(--card-back-glow, rgba(255,143,184,0.5)), inset 0 0 36rpx rgba(255,255,255,0.2);
  animation: emblemPulse 1s ease-in-out infinite alternate;
}
@keyframes emblemPulse {
  from { transform: scale(1); }
  to { transform: scale(1.07); }
}
.back-arc { position: absolute; top: 28rpx; left: 28rpx; right: 28rpx; bottom: 28rpx; border-radius: 40rpx; border: 2rpx dashed var(--card-back-arc, rgba(255,214,231,0.5)); }
.back-arc2 { position: absolute; top: 52rpx; left: 52rpx; right: 52rpx; bottom: 52rpx; border-radius: 32rpx; border: 2rpx solid var(--card-back-arc2, rgba(255,214,231,0.22)); }

/* ---- 卡片顶部工具栏：主题底 44px 高，左抽中数右分享/关闭 ---- */
.card-toolbar {
  position: relative;
  z-index: 2;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx 0 28rpx;
  background: var(--gradient-toolbar, linear-gradient(180deg, #FFFFFF, #FFF7FA));
  border-radius: 49rpx 49rpx 0 0; /* 卡片圆角 52rpx 内缩 */
  border-bottom: 1rpx solid var(--border-soft, #FCEFF5);
}
.tb-count { font-size: 22rpx; color: var(--text-secondary, #9C7B8C); }
.tb-btns { display: flex; gap: 8rpx; }
.tb-btn {
  width: 60rpx; height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--text-secondary, #9C7B8C);
  font-size: 32rpx;
}
.tb-btn:active { background: var(--color-accent-softer, #FBEFF5); color: var(--color-accent-strong, #E85D91); }

/* ---- 卡面：照片英雄区 + 信息区 ---- */
.face-front {
  background: var(--gradient-card-face, linear-gradient(172deg, #fff 55%, #FFF5F9 100%));
  border: 3rpx solid var(--card-face-border, rgba(255,222,236,0.95));
  box-shadow: var(--shadow-card-heavy, 0 60rpx 140rpx rgba(14,2,10,0.62), 0 0 0 10rpx rgba(255,255,255,0.06), inset 0 2rpx 0 #fff, 0 0 120rpx rgba(255,143,184,0.22));
}
/* 边缘斜向流光 */
.face-front::after {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 52rpx;
  pointer-events: none;
  z-index: 3;
  background: linear-gradient(128deg, rgba(255,255,255,0.55) 0%, transparent 18%, transparent 82%, var(--card-sheen-tint, rgba(255,214,231,0.35)) 100%);
}
.hero { position: relative; height: 400rpx; overflow: hidden; background: var(--bg-placeholder, #FFE9F2); }
.hero-img { width: 100%; height: 100%; display: block; }
/* 翻牌期间照片朦胧，翻定后聚焦清晰 */
.hero-img { filter: blur(32rpx) saturate(0.65); transform: scale(1.14); opacity: 0.5; }
.card-zone.flipped .hero-img { animation: photoFocus 0.55s cubic-bezier(0.22,1,0.36,1) forwards; }
@keyframes photoFocus { to { filter: blur(0) saturate(1); transform: scale(1); opacity: 1; } }
.hero-ph {
  background: var(--bg-placeholder, #FFEAF2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 140rpx;
  color: var(--color-accent, #FF8FB8);
}
/* 照片底部渐隐衔接信息区 */
.hero::after {
  content: "";
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 48rpx;
  background: linear-gradient(transparent, var(--card-face-fade, rgba(255,255,255,0.94)));
  pointer-events: none;
}

.fbody { padding: 24rpx 40rpx 36rpx; text-align: center; position: relative; margin-top: -20rpx; z-index: 2; }
.r-name { font-size: 52rpx; font-weight: 800; color: var(--text-primary, #4A2C3A); letter-spacing: 3rpx; text-shadow: 0 2rpx 0 var(--card-name-shadow, #fff); }
.r-chips { display: flex; gap: 14rpx; justify-content: center; margin-top: 16rpx; flex-wrap: wrap; }
.r-desc { font-size: 25rpx; color: var(--text-secondary, #9C7B8C); margin-top: 16rpx; line-height: 1.55; padding: 0 8rpx; }
.r-last { font-size: 20rpx; color: var(--text-hint, #C9B4C0); margin-top: 10rpx; opacity: 0.8; }
.r-link { margin-top: 16rpx; font-size: 24rpx; color: var(--color-accent-strong, #E85D91); font-weight: 600; }
/* 信息逐行浮现（仅翻面后触发） */
.r-name, .r-chips, .r-desc, .r-last, .r-link { opacity: 0; transform: translateY(18rpx); }
.card-zone.flipped .r-name { animation: lineUp 0.36s ease 0.34s forwards; }
.card-zone.flipped .r-chips { animation: lineUp 0.36s ease 0.44s forwards; }
.card-zone.flipped .r-desc { animation: lineUp 0.36s ease 0.54s forwards; }
.card-zone.flipped .r-last { animation: lineUp 0.36s ease 0.58s forwards; }
.card-zone.flipped .r-link { animation: lineUp 0.36s ease 0.62s forwards; }
@keyframes lineUp { to { opacity: 1; transform: translateY(0); } }
/* 扫光：翻面后一次掠过即停 */
.sheen {
  position: absolute;
  top: -70%; left: -65%;
  width: 48%; height: 240%;
  pointer-events: none;
  z-index: 4;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,0.55), transparent);
  transform: rotate(16deg);
  opacity: 0;
}
.card-zone.flipped .sheen { animation: sweepGo 0.7s cubic-bezier(0.3,0.6,0.3,1) 0.22s 1 forwards; }
@keyframes sweepGo { 0% { left: -65%; opacity: 0; } 12% { opacity: 1; } 100% { left: 155%; opacity: 0; } }

/* 蓄力聚能光晕（挂 card-zone 内跟随卡片；颜色用主题 RGB Token） */
.charge-glow {
  position: absolute;
  left: 50%; top: 50%;
  width: 800rpx; height: 800rpx;
  transform: translate(-50%, -50%) scale(0.4);
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
  opacity: 0;
  background: radial-gradient(circle, rgba(var(--glow-rgb, 255, 143, 184), 0.42), rgba(var(--glow-rgb, 255, 143, 184), 0.1) 42%, transparent 66%);
}
.charge-glow.on { opacity: 1; transform: translate(-50%, -50%) scale(1); animation: glowBreathe 0.7s ease-in-out infinite alternate; }
@keyframes glowBreathe {
  from { transform: translate(-50%, -50%) scale(0.92); opacity: 0.75; }
  to { transform: translate(-50%, -50%) scale(1.1); opacity: 1; }
}
/* 中心闪光（揭晓/换菜瞬间一次） */
.flash {
  position: absolute;
  left: 50%; top: 50%;
  width: 1120rpx; height: 1120rpx;
  transform: translate(-50%, -50%) scale(0);
  border-radius: 50%;
  pointer-events: none;
  z-index: 4;
  opacity: 0;
  background: radial-gradient(circle, rgba(255,255,255,0.98) 0%, var(--flash-tint, rgba(255,226,240,0.85)) 22%, var(--flash-edge, rgba(255,143,184,0.35)) 45%, transparent 68%);
}
.flash.go { animation: flashBoom 0.42s cubic-bezier(0.16,0.9,0.3,1) forwards; }
@keyframes flashBoom {
  0% { transform: translate(-50%, -50%) scale(0.08); opacity: 1; }
  22% { transform: translate(-50%, -50%) scale(0.55); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1.25); opacity: 0; }
}

/* ============ 弹层底部操作区 ============
   避让 = TabBar 内容区 112rpx + 凸起上探 35rpx + 安全间距 28rpx（v1.5.9 同源计算） */
.ov-actions {
  width: 100%;
  flex: none;
  margin-top: 40rpx; /* 卡片-首行间距：真机反馈 18rpx 过近，拉大到 40rpx */
  z-index: 6;
  opacity: 0;
  transform: translateY(36rpx);
  pointer-events: none;
  transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.22,1,0.36,1);
}
.ov.ready .ov-actions { opacity: 1; transform: translateY(0); pointer-events: auto; }
.action-row { display: flex; gap: 16rpx; }
.action-reject {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  background: var(--btn-reject-bg, rgba(255,255,255,0.92));
  color: var(--btn-reject-text, #B25478);
  border: 3rpx solid var(--btn-reject-border, #fff);
  box-shadow: 0 8rpx 32rpx rgba(10,2,8,0.4);
}
.action-accept { flex: 1.45; box-shadow: var(--shadow-accent, 0 16rpx 48rpx rgba(240,99,156,0.5)); }
/* ============ 小屏兜底（SE 级 667px）：缩卡+收信息，防卡片顶碰关闭钮 ============ */
@media (max-height: 800px) {
  .hero { height: 270rpx; }
  .action-row .action-reject, .action-row .action-accept { padding: 18rpx 0; }
  .r-name { font-size: 42rpx; }
  .fbody { padding: 18rpx 32rpx 32rpx; margin-top: -30rpx; }
  .r-last { display: none; }
  .r-desc { -webkit-line-clamp: 1; }
  .back-emblem { width: 170rpx; height: 170rpx; font-size: 86rpx; }
}

/* ============ 顶层面板：分享 sheet / 全屏海报（互斥，mask 阻断底层） ============ */
.top-panel {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1100;
}
.tp-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--mask-heavy, rgba(20,6,16,.55));
  opacity: 0;
  transition: opacity .22s ease;
}
.top-panel.open .tp-mask { opacity: 1; transition: opacity .28s ease; }
@keyframes tpFade { from { opacity: 0; } to { opacity: 1; } }
.sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  z-index: 2;
  background: var(--gradient-sheet, linear-gradient(180deg, #FFF9FB, #FFF2F7));
  border-radius: 56rpx 56rpx 0 0;
  /* 内容避让自定义 TabBar（恒在页面层之上）：112 内容区 + 35 凸起 + 16 间距 */
  /* TabBar 在抽屉打开时隐藏，底部仅需安全区 */
  padding: 36rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(110%);
  transition: transform .22s cubic-bezier(.4,0,1,1);
  box-shadow: 0 -36rpx 120rpx var(--mask-heavy, rgba(30,8,20,.45));
}
.top-panel.open .sheet {
  transform: translateY(0);
  transition: transform .28s cubic-bezier(.22,1,.36,1);
}
.sheet-grip { width: 84rpx; height: 8rpx; border-radius: 4rpx; background: var(--grip-color, #E8CBD8); margin: 0 auto 28rpx; }
.sheet-title { font-size: 30rpx; font-weight: 800; color: var(--text-primary, #4A2C3A); text-align: center; margin-bottom: 28rpx; }
.sheet-opts { display: flex; gap: 28rpx; }
.sheet-opt {
  flex: 1;
  background: var(--bg-card-solid, #fff);
  border: 3rpx solid var(--color-accent-border, #FFD6E7);
  border-radius: 36rpx;
  padding: 32rpx 16rpx;
  text-align: center;
  line-height: 1.4;
  margin: 0;
}
.sheet-opt::after { border: none; }
.so-ic {
  width: 92rpx; height: 92rpx;
  margin: 0 auto 16rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #fff;
}
/* 微信好友：品牌绿三主题通用；海报：主题强调色渐变 */
.so-ic.wechat { background: linear-gradient(135deg, #4CC05A, #2FA84F); }
.so-ic.poster { background: var(--gradient-poster-icon, linear-gradient(135deg, #FF8FB8, #E85D91)); }
.so-tx { font-size: 26rpx; font-weight: 700; color: var(--text-primary, #4A2C3A); }
.sheet-cancel {
  margin-top: 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary, #9C7B8C);
  background: var(--color-accent-softer, #FBEFF5);
  border-radius: 28rpx;
  padding: 24rpx 0;
}

/* ============ 全屏海报预览 ============ */
.poster-panel { z-index: 1200; }
.poster-full {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  background: var(--bg-poster-full, #1c0c14);
  animation: tpFade .28s ease;
}
.pf-head {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 20rpx; /* 顶距由 pfTop 实测胶囊底边写入 */
}
.pf-back, .pf-save-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--poster-preview-fg, #FFEAF3);
  font-size: 27rpx;
  font-weight: 700;
  background: var(--poster-preview-btn-bg, rgba(255,255,255,.1));
  border: 2rpx solid var(--poster-preview-border, rgba(255,222,236,.45));
  border-radius: 999rpx;
  padding: 16rpx 32rpx;
}
.pf-title { color: #fff; font-size: 28rpx; font-weight: 800; letter-spacing: 2rpx; }
.pf-body {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 40rpx;
  overflow: hidden;
}
.pf-img {
  max-width: 100%;
  max-height: 100%;
  border-radius: 28rpx;
  box-shadow: 0 32rpx 120rpx rgba(0,0,0,.55);
  background: #fff;
}
.pf-actions {
  flex: none;
  display: flex;
  justify-content: center;
  /* 海报预览期间 TabBar 隐藏，仅需安全区 */
  padding: 20rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
}
.pf-save {
  width: 440rpx;
  text-align: center;
  padding: 26rpx 0;
  box-shadow: var(--shadow-accent, 0 32rpx 96rpx rgba(240,99,156,.5));
}
@media (max-height: 800px) {
  .pf-body { padding: 8rpx 32rpx; }
  .pf-actions { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
}
