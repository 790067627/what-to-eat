.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  padding: 24rpx 24rpx 0;
}
/* 筛选+抽卡区独立滚动；底部留白避让 TabBar 与中间凸起按钮 */
.rand-scroll {
  flex: 1;
  min-height: 0;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 筛选卡：行高统一 92rpx，行间细分割线，控件右缘对齐 */
.filters { padding: 16rpx 28rpx; }
.filter-row {
  display: flex;
  align-items: center;
  height: 92rpx;
}
.filter-row + .filter-row { border-top: 1rpx solid #FCEFF5; }
.filter-label { font-size: 26rpx; color: #4A2C3A; width: 260rpx; flex-shrink: 0; }
.filter-slider { flex: 1; margin: 0 20rpx; }
.filter-value { font-size: 26rpx; color: #FF8FB8; font-weight: 600; width: 100rpx; text-align: right; }
/* switch/picker 靠右对齐，与滑块行右侧区域对齐 */
.filter-row switch { transform: scale(0.84); transform-origin: right center; }
.filter-row picker { margin-left: auto; }
.filter-picker {
  font-size: 26rpx;
  color: #FF8FB8;
  background: #FFF0F6;
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
}

/* 舞台区：紧跟筛选卡自然排布，不再撑满全屏居中 */
.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 0 40rpx;
}

/* 初始态：骰子+标题+说明+按钮为一个整体 */
.idle { text-align: center; width: 100%; }
.dice { font-size: 120rpx; margin-bottom: 20rpx; animation: float 2.4s ease-in-out infinite; }
/* 开始抽按钮：距说明 56rpx（48~64 区间） */
.roll-btn { width: 70%; margin: 56rpx auto 0; }
.add-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #C9A8B8;
  text-align: center;
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}
.idle-title { font-size: 40rpx; font-weight: 600; color: #4A2C3A; }
.idle-sub { font-size: 26rpx; color: #C9A8B8; margin-top: 12rpx; }
.error-tip {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #D96C99;
  background: #FFF0F6;
  border-radius: 16rpx;
  padding: 14rpx 28rpx;
  display: inline-block;
}

/* 滚动中 */
.rolling { width: 100%; }
.rolling .roll-btn { margin-top: 56rpx; }
.roll-card {
  width: 420rpx;
  height: 240rpx;
  margin: 0 auto;
  background: #fff;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFD6E7;
}
.roll-name { font-size: 48rpx; font-weight: 600; color: #FF8FB8; }
.shake { animation: shake 0.3s infinite; }
@keyframes shake {
  0%, 100% { transform: rotate(-2deg); }
  50% { transform: rotate(2deg); }
}

/* 结果 */
.result-card {
  width: 100%;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  text-align: center;
  border: 4rpx solid #FFD6E7;
}
.pop-in { animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }
@keyframes popIn {
  0% { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
.result-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  margin: 0 auto 24rpx;
  display: block;
}
.result-img-ph {
  background: #FFEAF2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}
.result-name { font-size: 48rpx; font-weight: 600; color: #4A2C3A; margin-bottom: 16rpx; }
.result-meta { margin-bottom: 14rpx; }
.result-last { font-size: 24rpx; color: #C9A8B8; margin-bottom: 16rpx; }
.result-desc { font-size: 26rpx; color: #9C7B8C; line-height: 1.6; padding: 0 20rpx; }
.result-link { font-size: 24rpx; color: #FF8FB8; margin-top: 16rpx; }

/* 操作区 */
.actions {
  flex-shrink: 0;
  /* 110rpx TabBar + 44rpx 中间凸起超出量 + 安全区 */
  padding: 24rpx 0 calc(154rpx + env(safe-area-inset-bottom));
  background: #FFF7FA;
}
.action-row { display: flex; gap: 20rpx; }
.action-reject {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #FBEFF5;
  color: #9C7B8C;
}
.action-accept { flex: 1.4; }


/* 海报按钮 */
.poster-btn {
  margin-top: 16rpx;
  text-align: center;
}
