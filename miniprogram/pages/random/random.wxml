<page-meta page-style="{{themeVars}}" root-background-color="{{themeWindowBg}}" background-color="{{themeWindowBg}}" background-text-style="{{themeJs.mode === 'dark' ? 'light' : 'dark'}}" />
<immersive-nav />
<view class="page" style="padding-top: {{navHeight + contentTopOffset}}px">
  <!-- 背景内容（弹层打开时整体暗化模糊；filter 只作用于此层，不含弹层） -->
  <view class="page-body {{ovShow ? 'dimmed' : ''}} {{settingsOpen ? 'settings-open' : ''}}">
    <!-- ① 抽取设置：可折叠卡片，默认收起展示当前设置摘要 -->
    <view class="card settings {{settingsOpen ? 'open' : ''}}">
      <view class="settings-head" bindtap="toggleSettings" hover-class="settings-head-hover" hover-stay-time="80">
        <view class="settings-titles">
          <view class="settings-title">抽取设置</view>
          <view class="settings-summary">{{excludeDays === 0 ? '不排除近期' : '排除近' + excludeDays + '天'}}{{onlyWant ? ' · 仅想吃' : ''}}{{weightByRating ? ' · 高分优先' : ''}}{{categoryFilterName ? ' · ' + categoryFilterName : ''}}</view>
        </view>
        <view class="settings-arrow"></view>
      </view>
      <view class="settings-body">
      <view class="settings-inner">
      <view class="filter-row">
        <text class="filter-label">排除最近吃过的</text>
        <slider
          class="filter-slider"
          min="0" max="14" step="1"
          value="{{excludeDays}}"
          activeColor="{{themeJs.slider.active}}"
          backgroundColor="{{themeJs.slider.track}}"
          block-size="20"
          bindchanging="onDaysChange"
          bindchange="onDaysChange"
        />
        <text class="filter-value">{{excludeDays === 0 ? '不排除' : excludeDays + '天'}}</text>
      </view>
      <view class="filter-row">
        <text class="filter-label">只从「想吃」里抽</text>
        <switch checked="{{onlyWant}}" color="{{themeJs.switchColor}}" bindchange="toggleWant" />
      </view>
      <view class="filter-row">
        <text class="filter-label">高分优先</text>
        <switch checked="{{weightByRating}}" color="{{themeJs.switchColor}}" bindchange="toggleWeight" />
      </view>
      <view class="filter-row">
        <text class="filter-label">限定分类</text>
        <picker range="{{categoryNames}}" bindchange="onCategoryChoose">
          <view class="filter-picker">{{categoryFilterName || '不限'}} ▾</view>
        </picker>
      </view>
      </view>
      </view>
    </view>

    <!-- ② 抽取交互卡片：骰子+标题+辅助文案+开始抽取，统一视觉焦点 -->
    <view class="idle-stage">
      <view class="card roll-card">
        <view class="dice bi"><text class="bi"></text></view>
        <view class="idle-title">今天吃点什么？</view>
        <view class="idle-sub">让命运替你决定</view>
        <view wx:if="{{errorMessage}}" class="error-tip">{{errorMessage}}</view>
        <view class="btn-primary roll-btn" bindtap="onRoll">开始抽取</view>
      </view>
      <!-- 次级文字入口：核心卡片下方 -->
      <view class="add-hint" bindtap="goAdd">菜品库不够丰富？去加几道 ›</view>
    </view>
  </view>

  <!-- ③ 全屏沉浸揭晓弹层：卡片+操作按钮为整体，按可用高度居中 -->
  <view wx:if="{{ovShow}}" class="ov {{ovIn ? 'in' : ''}} {{ovReady ? 'ready' : ''}}" catchtouchmove="noop">
    <view class="ov-bg"></view>
    <!-- 粒子层：canvas 必须显式 width/height 100%，防替换元素尺寸失控 -->
    <canvas type="2d" id="fx" class="fx"></canvas>
    <!-- 上占位=导航实际底边 T（测量值）；下占位=窗口高-TabBar凸起顶边 B -->
    <view class="ov-spacer" style="height: {{ovTop}}px"></view>
    <view class="ov-body">
      <view class="ov-stage {{zoomPunch ? 'zoompunch' : ''}}">
        <view class="card-zone {{zoneClass}}">
          <view class="charge-glow {{glowOn ? 'on' : ''}}"></view>
          <view class="flash {{flashGo ? 'go' : ''}}"></view>
          <!-- 卡牌 3D：transform 由 JS 逐帧写入（WXSS 动画会压平 preserve-3d，禁用） -->
          <view class="card-inner" style="transform: perspective(1100px) {{cardTf}}">
            <!-- 卡背：樱花纹样 + bi 骰子徽标 -->
            <view class="face face-back">
              <view class="back-arc"></view>
              <view class="back-arc2"></view>
              <view class="back-emblem bi"><text class="bi"></text></view>
            </view>
            <!-- 卡面：云存储封面为英雄区，无图走统一 bi 占位 -->
            <view class="face face-front">
              <view class="sheen"></view>
              <!-- 卡片顶部工具栏：左抽中数 / 右分享+关闭（线性 bi 图标，不遮照片） -->
              <view class="card-toolbar">
                <text class="tb-count">从 {{result.poolSize}} 道里抽中</text>
                <view class="tb-btns">
                  <view class="tb-btn" bindtap="onShareTap"><text class="bi"></text></view>
                  <view class="tb-btn" bindtap="onCloseOverlay"><text class="bi"></text></view>
                </view>
              </view>
              <view class="hero">
                <image wx:if="{{result.dish.coverImage}}" class="hero-img" src="{{result.dish.coverImage}}" mode="aspectFill" />
                <view wx:else class="hero-img hero-ph bi"><text class="bi"></text></view>
              </view>
              <view class="fbody">
                <view class="r-name">{{result.dish.name}}</view>
                <view class="r-chips">
                  <text wx:if="{{result.categoryName}}" class="chip chip-plain">{{result.categoryName}}</text>
                  <text wx:if="{{result.dish.priceYuan}}" class="chip">¥{{result.dish.priceYuan}}</text>
                  <text wx:if="{{result.dish.rating}}" class="chip chip-plain">★{{result.dish.rating}}</text>
                </view>
                <view class="r-desc ellipsis-2" wx:if="{{result.dish.description}}">{{result.dish.description}}</view>
                <view class="r-last">{{lastEatenText}}</view>
                <view class="r-link" bindtap="goDetail">查看详情 ›</view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <!-- 操作区：与卡片同属居中整体；主次配色保留 -->
      <view class="ov-actions">
        <view class="action-row">
          <view class="btn-ghost action-reject" bindtap="onReject"><text class="bi"></text> 不想吃，换一个</view>
          <view class="btn-primary action-accept" bindtap="onAccept"><text class="bi"></text> 就它了，记一笔</view>
        </view>
      </view>
    </view>
    <view class="ov-spacer" style="height: {{ovBottom}}px"></view>
  </view>
</view>

<!-- ===== 顶层面板：分享 Bottom Sheet（与抽卡弹层互斥） ===== -->
<view wx:if="{{shareMounted}}" class="top-panel {{shareOpen ? 'open' : ''}}">
  <view class="tp-mask" bindtap="closeShare"></view>
  <view class="sheet" catchtap="noop">
    <view class="sheet-grip"></view>
    <view class="sheet-title">分享这道菜</view>
    <view class="sheet-opts">
      <button class="sheet-opt" open-type="share" bindtap="closeShare">
        <view class="so-ic wechat bi"><text class="bi"></text></view>
        <view class="so-tx">分享给微信好友</view>
      </button>
      <view class="sheet-opt" bindtap="onSharePoster">
        <view class="so-ic poster bi"><text class="bi"></text></view>
        <view class="so-tx">生成分享海报</view>
      </view>
    </view>
    <view class="sheet-cancel" bindtap="closeShare">取消</view>
  </view>
</view>

<!-- ===== 顶层面板：全屏海报预览（覆盖结果层，不叠加弹窗） ===== -->
<view wx:if="{{posterOpen}}" class="top-panel open poster-panel">
  <view class="poster-full">
    <view class="pf-head" style="padding-top: {{pfTop}}px">
      <view class="pf-back" bindtap="closePoster"><text class="bi"></text> 返回</view>
      <view class="pf-title">分享海报</view>
      <view class="pf-save-top" bindtap="onSavePoster">保存</view>
    </view>
    <view class="pf-body">
      <image class="pf-img" src="{{posterUrl}}" mode="aspectFit" show-menu-by-longpress="{{true}}" />
    </view>
    <view class="pf-actions">
      <view class="btn-primary pf-save" bindtap="onSavePoster"><text class="bi"></text> 保存到相册</view>
    </view>
  </view>
</view>
<poster id="poster" dish="{{result.dish}}" category-name="{{result.categoryName}}" />
