<page-meta page-style="{{themeVars}}" root-background-color="{{themeWindowBg}}" background-color="{{themeWindowBg}}" background-text-style="{{themeJs.mode === 'dark' ? 'light' : 'dark'}}" />
<!-- page-meta 必须是页面第一个节点：把主题 CSS 变量注入 page 根节点，全页样式即时生效 -->

<sakura-bg id="kitty" />

<immersive-nav />

<view class="page" style="padding-top: {{navHeight + contentTopOffset}}px" bindtap="onPageTap">
  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="skeleton-item"><view class="skeleton-img"></view>
      <view style="flex:1"><view class="skeleton-line" style="width:60%"></view><view class="skeleton-line" style="width:40%"></view></view>
    </view>
    <view class="skeleton-item"><view class="skeleton-img"></view>
      <view style="flex:1"><view class="skeleton-line" style="width:70%"></view><view class="skeleton-line" style="width:30%"></view></view>
    </view>
  </block>

  <block wx:else>
    <!-- 问候 + 随机入口 -->
    <view class="hero card">
      <view class="hero-greeting">{{greeting}}</view>
      <view class="hero-sub" wx:if="{{inited}}">纠结的话，交给运气吧 </view>
      <view class="hero-sub" wx:else>先建个菜品库，再让运气帮你选 </view>
      <view class="btn-primary hero-btn" bindtap="goRandom"><text class="bi"></text> 帮我随机抽一道</view>
    </view>

    <!-- 未初始化：引导 -->
    <view wx:if="{{!inited}}" class="card init-card">
      <view class="section-title">菜品库还是空的</view>
      <view class="init-desc">两种方式开始：</view>
      <view class="btn-primary" style="margin-bottom:16rpx" bindtap="goAdd">＋ 手动添加第一道菜</view>
      <view class="btn-ghost" bindtap="onInitDemo">一键载入示例数据（6道菜+5个分类）</view>
    </view>

    <block wx:else>
      <!-- 今日推荐 -->
      <view class="section-title" wx:if="{{todayDish}}">今日推荐</view>
      <view wx:if="{{todayDish}}" class="card today-card" data-id="{{todayDish._id}}" bindtap="goDetail">
        <image wx:if="{{todayDish.coverImage}}" class="today-img" src="{{todayDish.coverImage}}" mode="aspectFill" lazy-load />
        <view wx:else class="today-img today-img-placeholder"><text class="bi"></text></view>
        <view class="today-info">
          <view class="today-name ellipsis">{{todayDish.name}}</view>
          <view class="today-desc ellipsis-2" wx:if="{{todayDish.description}}">{{todayDish.description}}</view>
          <view class="today-meta">
            <text wx:if="{{todayDish.rating}}" class="today-rating">★ {{todayDish.rating}}</text>
            <text wx:if="{{todayDish.categoryName}}" class="chip chip-plain">{{todayDish.categoryName}}</text>
            <text wx:if="{{todayDish.priceYuan}}" class="chip">¥{{todayDish.priceYuan}}</text>
          </view>
        </view>
      </view>

      <!-- 分类速览 -->
      <view class="flex-between">
        <view class="section-title">分类速览</view>
        <view class="more-link" bindtap="goDishes">全部菜品 ›</view>
      </view>
      <view class="cat-grid">
        <view
          wx:for="{{categories}}"
          wx:key="_id"
          class="cat-cell card"
          data-id="{{item._id}}"
          data-name="{{item.name}}"
          bindtap="goCategory"
        >
          <view class="cat-icon bi">{{item.icon}}</view>
          <view class="cat-name ellipsis">{{item.name}}</view>
        </view>
        <view wx:if="{{!categories.length}}" class="empty-hint">还没有分类，去「我的 → 分类管理」添加</view>
      </view>
    </block>

    <view style="height: 160rpx"></view>
  </block>
</view>
