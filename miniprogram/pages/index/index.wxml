<page-meta page-style="{{themeVars}}{{sheetShow ? ';overflow:hidden' : ''}}" root-background-color="{{themeWindowBg}}" background-color="{{themeWindowBg}}" background-text-style="{{themeJs.mode === 'dark' ? 'light' : 'dark'}}" />
<!-- page-meta 必须是页面第一个节点：把主题 CSS 变量注入 page 根节点，全页样式即时生效 -->

<immersive-nav />

<!-- 蜂蜜主题导航角色装饰（非蜂蜜主题组件内部不渲染不加载） -->
<nav-bears />

<view class="page" style="padding-top: {{navHeight + contentTopOffset}}px" bindtap="onPageTap">
  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="skeleton-item"><view class="skeleton-img"></view>
      <view style="flex:1"><view class="skeleton-line" style="width:60%"></view><view class="skeleton-line" style="width:40%"></view></view>
    </view>
    <view class="skeleton-item"><view class="skeleton-img"></view>
      <view style="flex:1"><view class="skeleton-line" style="width:70%"></view><view class="skeleton-line" style="width:30%"></view></view>
    </view>
  </block>

  <block wx:else>
    <!-- 未初始化：引导（保留原有一键示例 + 手动添加） -->
    <view wx:if="{{!inited && !feedQueue.length}}" class="card init-card">
      <view class="section-title">菜品库还是空的</view>
      <view class="init-desc">两种方式开始：</view>
      <view class="btn-primary" style="margin-bottom:16rpx" bindtap="goAdd">＋ 手动添加第一道菜</view>
      <view class="btn-ghost" bindtap="onInitDemo">一键载入示例数据（6道菜+5个分类）</view>
    </view>

    <block wx:else>
      <!-- 问候行（编辑感排版，方案 A 视觉冻结） -->
      <view class="insp-head">
        <view class="insp-greeting">{{greeting}}</view>
        <view class="insp-sub">
          <text>AI 饮食灵感</text>
          <text class="insp-idx" wx:if="{{idxText}}">{{idxText}}</text>
        </view>
        <view class="insp-cold" wx:if="{{coldStart}}" bindtap="goTastePrefs">先设置口味偏好，推荐更准 ›</view>
        <view class="insp-cold" wx:if="{{legacyCloud}}" bindtap="retryFeed">推荐服务待部署 · 当前仅展示你的菜单（点按重试）</view>
      </view>

      <!-- 卡栈：AI 饮食灵感主体（方案 A · Swiper Cards 交互模型原生实现） -->
      <view class="stack-zone" style="height: {{stackHeightPx}}px">
        <card-stack
          id="cardStack"
          queue="{{feedQueue}}"
          reset-token="{{feedResetToken}}"
          loading="{{feedLoading && !feedQueue.length}}"
          interaction-locked="{{stackLocked}}"
          bind:advance="onAdvance"
          bind:cardtap="onCardTap"
          bind:notinterest="onNotInterest"
        />
      </view>

      <!-- 操作区：喜欢 / 换一道 / 想吃（方案 A 视觉冻结） -->
      <view class="insp-actions">
        <view class="insp-btn round {{curLiked ? 'on' : ''}}" bindtap="onLike">{{curLiked ? '♥' : '♡'}}</view>
        <view class="insp-btn primary" bindtap="onNext">换一道</view>
        <view class="insp-btn {{curSaved ? 'added' : ''}}" bindtap="onWant">{{curSaved ? '✓ 已入清单' : '想吃'}}</view>
      </view>

      <view class="insp-hint">左右滑动换菜 · 点卡片看详情 · 长按不感兴趣</view>
    </block>

    <!-- 樱花主题 Kitty 装饰：文档流内、随内容自然排列；其他主题组件内部 wx:if 不渲染不占位。
         必须放 .page 内：page-meta root-background-color 会盖住 z-index:-1 的 fixed 元素（规范 4.8-7） -->
    <sakura-bg id="kitty" />
  </block>
</view>

<!-- 底部详情抽屉（方案 A 视觉冻结项） -->
<dish-sheet
  id="sheet"
  item="{{sheetItem}}"
  show="{{sheetShow}}"
  bind:close="onSheetClose"
  bind:closed="onSheetClosed"
  bind:like="onSheetLike"
  bind:want="onSheetWant"
/>
