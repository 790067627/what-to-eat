/* ===== 沉浸式插画导航区 ===== */
.hero-header {
  position: relative;
  overflow: hidden;
  /* 图片缺失时的兜底渐变，布局不塌 */
  background: linear-gradient(180deg, #FFEAF2, #FFF7FA);
}
.hero-header-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}
/* 轻微白罩：保证标题/状态栏文字在插画上清晰 */
.hero-header-veil {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.16);
}
/* 底部渐隐到页面底色 #FFF7FA，消除硬分界 */
.hero-header-fade {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 56rpx;
  background: linear-gradient(180deg, rgba(255, 247, 250, 0), #FFF7FA);
}
.hero-header-bar {
  position: absolute;
  top: 0; left: 0; right: 0;
  box-sizing: border-box;
}
.hero-header-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #4A2C3A;
  text-shadow: 0 1rpx 6rpx rgba(255, 255, 255, 0.75);
}

.page { padding: 24rpx; }

/* 顶部问候卡 */
.hero {
  background: linear-gradient(135deg, rgba(255,240,246,0.92), rgba(255,227,239,0.92));
  text-align: center;
  padding: 40rpx 32rpx;
}
.hero-greeting { font-size: 34rpx; font-weight: 600; color: #4A2C3A; }
.hero-sub { font-size: 24rpx; color: #D96C99; margin: 10rpx 0 26rpx; }
.hero-btn { width: 70%; margin: 0 auto; }

/* 初始化引导 */
.init-card { text-align: center; padding: 40rpx 32rpx; }
.init-desc { font-size: 24rpx; color: #9C7B8C; margin-bottom: 24rpx; }

/* 今日推荐 */
.today-card { display: flex; gap: 20rpx; }
.today-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
}
.today-img-placeholder {
  background: #FFEAF2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}
.today-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.today-name { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.today-desc { font-size: 24rpx; color: #9C7B8C; margin-bottom: 12rpx; line-height: 1.5; }
.today-meta { margin-top: auto; }
.today-rating { color: #FF9500; font-size: 24rpx; margin-right: 12rpx; }

/* 分类速览 */
.more-link { font-size: 24rpx; color: #FF8FB8; margin-bottom: 16rpx; }
.cat-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.cat-cell {
  width: calc((100% - 40rpx) / 3);
  margin-bottom: 0;
  text-align: center;
  padding: 28rpx 12rpx;
}
.cat-icon { font-size: 52rpx; margin-bottom: 10rpx; }
.cat-name { font-size: 24rpx; color: #4A2C3A; }
.empty-hint { width: 100%; text-align: center; color: #C9A8B8; font-size: 24rpx; padding: 30rpx 0; }
