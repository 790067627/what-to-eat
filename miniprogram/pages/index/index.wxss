/* pages/index/index.wxss — 首页：AI 饮食灵感（方案 A 卡栈）
 * 高度模型：page 撑满视口，stack-zone flex:1 占中段，操作区固定底部；
 * padding-bottom 保留 TabBar 让位（112rpx + 安全区，MEMORY 定稿模型）。 */
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 24rpx 24rpx calc(112rpx + constant(safe-area-inset-bottom) + 24rpx);
  padding: 24rpx 24rpx calc(112rpx + env(safe-area-inset-bottom) + 24rpx);
}

/* 初始化引导 */
.init-card { text-align: center; padding: 40rpx 32rpx; }
.init-desc { font-size: 24rpx; color: var(--text-secondary, #9C7B8C); margin-bottom: 24rpx; }

/* ===== 问候行（编辑感排版） ===== */
.insp-head { flex: none; padding: 8rpx 8rpx 20rpx; }
.insp-greeting {
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  color: var(--text-primary, #4A2C3A);
}
.insp-em {
  font-style: italic;
  color: var(--color-accent-strong, #E85D91);
}
.insp-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: var(--text-hint, #C9A8B8);
}
.insp-idx { font-weight: 700; color: var(--color-accent-strong, #E85D91); letter-spacing: 2rpx; }
.insp-cold {
  margin-top: 14rpx;
  display: inline-block;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--color-accent-strong, #E85D91);
  background: var(--color-accent-soft, #FFF0F6);
  border: 1rpx dashed var(--color-accent-border, #FFD6E7);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}

/* ===== 卡栈区 ===== */
.stack-zone {
  flex: 1;
  min-height: 760rpx;
  position: relative;
  margin: 0 8rpx;
}

/* ===== 操作区 ===== */
.insp-actions {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 28rpx 0 8rpx;
}
.insp-btn {
  height: 92rpx;
  min-width: 92rpx;
  padding: 0 36rpx;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: var(--text-primary, #4A2C3A);
  background: var(--bg-card-solid, #FFFFFF);
  border: 2rpx solid var(--border-default, #F8E3EC);
  box-shadow: var(--shadow-card, 0 6rpx 24rpx rgba(217,108,153,0.08));
  transition: transform 150ms, color 200ms, border-color 200ms, background 200ms;
}
.insp-btn:active { transform: scale(0.94); }
.insp-btn.round { padding: 0; width: 92rpx; font-size: 40rpx; color: var(--text-secondary, #9C7B8C); }
.insp-btn.round.on { color: #FF5A79; border-color: #FF5A79; background: rgba(255, 90, 121, 0.1); }
.insp-btn.primary {
  color: var(--text-on-accent, #FFFFFF);
  background: var(--gradient-primary, linear-gradient(135deg, #FFB3D1, #FF8FB8));
  border-color: transparent;
  padding: 0 52rpx;
  box-shadow: var(--shadow-accent, 0 16rpx 48rpx rgba(240,99,156,0.5));
}
.insp-btn.added {
  color: var(--color-success, #639922);
  border-color: var(--color-success, #639922);
  background: var(--color-success-bg, #EAF3DE);
}

.insp-hint {
  flex: none;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--text-hint, #C9A8B8);
  padding: 10rpx 0 4rpx;
}
