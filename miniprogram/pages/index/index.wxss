/* pages/index/index.wxss — 首页：AI 饮食灵感（方案 A 卡栈）
 * 高度模型：page 撑满视口，stack-zone flex:1 占中段，操作区固定底部；
 * padding-bottom 保留 TabBar 让位（112rpx + 安全区，MEMORY 定稿模型）。 */
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 24rpx 24rpx calc(112rpx + constant(safe-area-inset-bottom) + 24rpx);
  padding: 24rpx 24rpx calc(112rpx + env(safe-area-inset-bottom) + 24rpx);
}

/* 初始化引导 */
.init-card { text-align: center; padding: 40rpx 32rpx; }
.init-desc { font-size: 24rpx; color: var(--text-secondary, #9C7B8C); margin-bottom: 24rpx; }

/* ===== 问候行（编辑感排版） ===== */
.insp-head { flex: none; padding: 4rpx 8rpx 12rpx; }
.insp-greeting {
  font-size: 30rpx;                 /* POC hud-title 15px */
  font-weight: 800;
  letter-spacing: 1rpx;
  color: var(--text-primary, #4A2C3A);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.insp-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--text-hint, #C9A8B8);
}
.insp-idx { font-weight: 700; color: var(--color-accent-strong, #E85D91); letter-spacing: 2rpx; }
.insp-cold {
  margin-top: 14rpx;
  display: inline-block;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--color-accent-strong, #E85D91);
  background: var(--color-accent-soft, #FFF0F6);
  border: 1rpx dashed var(--color-accent-border, #FFD6E7);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}

/* ===== 卡栈区 ===== */
.stack-zone {
  /* 高度由 wxml 内联 stackHeightPx 给定（确定值，按设备动态计算）：
     真机 WKWebView 中 flex 子项 auto 高度内的 height:100% 会解析为 0 */
  flex: none;
  position: relative;
  margin: 8rpx 8rpx 0;   /* 紧贴问候行下方（POC），操作区紧随卡片 */
}
/* 自定义组件标签本身必须显式撑高：组件内部 height:100% 依赖标签有确定高度，
   否则百分比对 auto 塌陷为 0，整叠卡不可见（真机空白 bug 根因） */
.stack-zone card-stack {
  display: block;
  width: 100%;
  height: 100%;
}

/* ===== 操作区（POC .actions/.act 逐值：48px 高 / gap 14px / 14px 字 / radius 24px） ===== */
.insp-actions {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;                    /* 14px */
  padding: 28rpx 0 0;            /* POC .phone gap:14px */
}
.insp-btn {
  height: 96rpx;                 /* 48px */
  min-width: 96rpx;
  padding: 0 36rpx;              /* 18px */
  border-radius: 48rpx;          /* 24px */
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;              /* 14px */
  font-weight: 700;
  color: var(--text-primary, #e6edf3);
  background: var(--bg-hover, rgba(255,255,255,0.06));
  border: 2rpx solid var(--border-default, rgba(255,255,255,0.14));
  transition: transform 150ms, color 200ms, border-color 200ms, background 200ms;
}
.insp-btn:active { transform: scale(0.94); }
.insp-btn.round { padding: 0; width: 96rpx; font-size: 40rpx; }   /* 心形钮 20px 图标 */
.insp-btn.round.on { color: #ff5a79; border-color: #ff5a79; background: rgba(255,90,121,0.12); }
.insp-btn.primary {
  color: var(--text-on-accent, #fff);
  background: var(--gradient-primary, linear-gradient(135deg,#238636,#2ea043));
  border-color: transparent;
  padding: 0 52rpx;              /* 26px */
}
.insp-btn.added { color: #3fb950; border-color: #3fb950; background: rgba(63,185,80,0.12); }

.insp-hint {
  flex: none;
  text-align: center;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: var(--text-faint, #D8BAC9);   /* 弱化，不抢视觉焦点 */
  padding: 6rpx 0 0;
  opacity: 0.7;
}
