.page {
  padding: 24rpx;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
/* 详情内容区独立滚动 */
.detail-scroll { flex: 1; min-height: 0; }

/* 头图 */
.cover {
  width: 100%;
  height: 420rpx;
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
}
.cover-ph {
  background: var(--bg-placeholder, #FFEAF2);
  color: var(--color-accent, #FF8FB8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
}

/* 信息卡 */
.name-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.name { font-size: 40rpx; font-weight: 600; flex: 1; min-width: 0; }
.edit-btn { font-size: 26rpx; color: var(--color-accent, #FF8FB8); flex-shrink: 0; padding-left: 20rpx; }
.meta { margin-bottom: 24rpx; }
.last-eaten { font-size: 22rpx; color: var(--text-hint, #C9A8B8); margin-left: 8rpx; }

/* 评分 */
.rate-row { display: flex; align-items: center; margin-bottom: 24rpx; }
.rate-label { font-size: 26rpx; color: var(--text-secondary, #9C7B8C); margin-right: 20rpx; }
.stars { display: flex; }
.star { font-size: 44rpx; color: var(--star-off, #F8E3EC); margin-right: 12rpx; }
.star.on { color: var(--color-star, #FF9500); }

/* 状态 */
.status-row { display: flex; gap: 16rpx; }
.status-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 16rpx 0;
  border-radius: 40rpx;
  background: var(--color-accent-softer, #FBEFF5);
  color: var(--text-secondary, #9C7B8C);
  border: 2rpx solid transparent;
}
.status-btn.on {
  background: var(--color-accent-soft, #FFF0F6);
  color: var(--color-accent, #FF8FB8);
  font-weight: 600;
  border: 2rpx solid var(--color-accent-border, #FFD6E7);
}

/* 介绍 */
.desc { font-size: 28rpx; color: var(--text-primary, #4A2C3A); line-height: 1.7; white-space: pre-wrap; }

/* 图片网格 */
.img-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.grid-img {
  width: calc((100% - 32rpx) / 3);
  height: 210rpx;
  border-radius: var(--radius-sm);
}

/* 操作按钮区 */
.action-section {
  flex-shrink: 0;
  padding-top: 16rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--bg-page, #FFF7FA);   /* 实底：内容滚过按钮区时不透出 */
}

/* 记一笔按钮 - 独占一行 */
.log-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 0;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.log-btn .bi {
  margin-right: 8rpx;
}

/* 分享按钮行 - 两个等宽按钮 */
.share-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.share-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  background: var(--color-accent-softer, #FBEFF5);
  color: var(--color-accent-deep, #D96C99);
  border: 2rpx solid var(--color-accent-border, #FFD6E7);
  margin: 0;
}

.share-btn .bi {
  margin-right: 8rpx;
  font-size: 28rpx;
}

/* 删除链接 - 居中 */
.delete-link {
  text-align: center;
  color: var(--text-hint, #C9A8B8);
  font-size: 26rpx;
  padding: 16rpx;
  margin-top: 8rpx;
}

/* 海报按钮 */
.poster-btn {
  margin-top: 16rpx;
  text-align: center;
}

/* ===== 公开快照模式（P1） ===== */
.public-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.public-author { font-size: 24rpx; color: var(--text-secondary, #9C7B8C); }
.like-row { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 20rpx; border-radius: 999rpx;
  background: var(--bg-sunken, #FDF5F9); border: 1rpx solid var(--border-soft, #FCEFF5); }
.like-heart { font-size: 32rpx; color: var(--text-hint, #C9A8B8); }
.like-heart.on { color: #FF5A79; }
.like-count { font-size: 24rpx; color: var(--text-secondary, #9C7B8C); font-weight: 600; }
.expired-hint { text-align: center; font-size: 26rpx; color: var(--text-hint, #C9A8B8); padding: 20rpx 0; }

/* ===== 公开发布入口（P1） ===== */
.pub-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.pub-status { font-size: 24rpx; font-weight: 600; padding: 8rpx 20rpx; border-radius: 999rpx; }
.pub-status.pending { color: var(--color-star, #FF9500); background: var(--bg-sunken, #FDF5F9); }
.pub-status.approved { color: var(--color-success, #639922); background: var(--color-success-bg, #EAF3DE); }
.pub-status.rejected { color: #D1242F; background: var(--bg-sunken, #FDF5F9); }
.pub-withdraw { font-size: 24rpx; color: var(--text-secondary, #9C7B8C); text-decoration: underline; }
.pub-mask { position: fixed; inset: 0; z-index: 900; background: var(--mask-heavy, rgba(20,6,16,0.55)); }
.pub-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 901;
  background: var(--bg-sheet, #FFFFFF); border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); max-height: 82vh; overflow-y: auto; }
.pub-sheet-title { font-size: 32rpx; font-weight: 800; color: var(--text-primary, #4A2C3A); }
.pub-sheet-desc { font-size: 24rpx; color: var(--text-secondary, #9C7B8C); margin-top: 8rpx; line-height: 1.6; }
.pub-preview { display: flex; align-items: center; gap: 16rpx; margin: 24rpx 0;
  padding: 16rpx; border-radius: 16rpx; background: var(--bg-sunken, #FDF5F9); }
.pub-preview-img { width: 96rpx; height: 96rpx; border-radius: 12rpx; flex: none; }
.pub-preview-name { font-size: 28rpx; font-weight: 700; color: var(--text-primary, #4A2C3A); }
.pub-preview-tags { font-size: 22rpx; color: var(--text-hint, #C9A8B8); margin-top: 4rpx; }
.pub-opt { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0;
  font-size: 27rpx; color: var(--text-primary, #4A2C3A); }
.pub-check { width: 40rpx; height: 40rpx; border-radius: 10rpx; flex: none;
  border: 2rpx solid var(--border-strong, #F0C0D4); text-align: center; line-height: 40rpx;
  font-size: 24rpx; color: var(--text-on-accent, #FFFFFF); }
.pub-check.on { background: var(--color-accent, #FF8FB8); border-color: var(--color-accent, #FF8FB8); }
.pub-submit { margin-top: 24rpx; }

/* 发布预览：转载来源明示 */
.pub-derived {
  margin: 16rpx 0 4rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: var(--bg-sunken, #FDF5F9);
  border: 1rpx dashed var(--border-strong, #F0C0D4);
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--text-secondary, #9C7B8C);
}
