.page {
  padding: 24rpx;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
/* 详情内容区独立滚动 */
.detail-scroll { flex: 1; min-height: 0; }

/* 头图 */
.cover {
  width: 100%;
  height: 420rpx;
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
}
.cover-ph {
  background: #FFEAF2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
}

/* 信息卡 */
.name-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.name { font-size: 40rpx; font-weight: 600; flex: 1; min-width: 0; }
.edit-btn { font-size: 26rpx; color: #FF8FB8; flex-shrink: 0; padding-left: 20rpx; }
.meta { margin-bottom: 24rpx; }
.last-eaten { font-size: 22rpx; color: #C9A8B8; margin-left: 8rpx; }

/* 评分 */
.rate-row { display: flex; align-items: center; margin-bottom: 24rpx; }
.rate-label { font-size: 26rpx; color: #9C7B8C; margin-right: 20rpx; }
.stars { display: flex; }
.star { font-size: 44rpx; color: #F8E3EC; margin-right: 12rpx; }
.star.on { color: #FF9500; }

/* 状态 */
.status-row { display: flex; gap: 16rpx; }
.status-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 16rpx 0;
  border-radius: 40rpx;
  background: #FBEFF5;
  color: #9C7B8C;
}
.status-btn.on {
  background: #FFF0F6;
  color: #FF8FB8;
  font-weight: 600;
  border: 2rpx solid #FFD6E7;
}

/* 介绍 */
.desc { font-size: 28rpx; color: #4A2C3A; line-height: 1.7; white-space: pre-wrap; }

/* 图片网格 */
.img-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.grid-img {
  width: calc((100% - 32rpx) / 3);
  height: 210rpx;
  border-radius: var(--radius-sm);
}

/* 操作按钮区 */
.action-section {
  flex-shrink: 0;
  padding-top: 16rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFF7FA;   /* 实底：内容滚过按钮区时不透出 */
}

/* 记一笔按钮 - 独占一行 */
.log-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 0;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.log-btn .bi {
  margin-right: 8rpx;
}

/* 分享按钮行 - 两个等宽按钮 */
.share-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.share-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  background: #FBEFF5;
  color: #D96C99;
  border: 2rpx solid #FFD6E7;
  margin: 0;
}

.share-btn .bi {
  margin-right: 8rpx;
  font-size: 28rpx;
}

/* 删除链接 - 居中 */
.delete-link {
  text-align: center;
  color: #C9A8B8;
  font-size: 26rpx;
  padding: 16rpx;
  margin-top: 8rpx;
}

/* 海报按钮 */
.poster-btn {
  margin-top: 16rpx;
  text-align: center;
}
