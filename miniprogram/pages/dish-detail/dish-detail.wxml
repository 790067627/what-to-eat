<page-meta page-style="{{themeVars}}" root-background-color="{{themeWindowBg}}" background-color="{{themeWindowBg}}" background-text-style="{{themeJs.mode === 'dark' ? 'light' : 'dark'}}" />
<custom-navbar title="菜品详情" />

<view class="page" wx:if="{{!loading && dish}}" style="padding-top: {{navbarHeight}}px;">
  <scroll-view class="detail-scroll" scroll-y>
  <!-- 头图 -->
  <image
    wx:if="{{dish.coverImage}}"
    class="cover"
    src="{{dish.coverImageUrl || dish.coverImage}}"
    mode="aspectFill"
    data-url="{{dish.coverImageUrl || dish.coverImage}}"
    bindtap="previewImage"
  />
  <view wx:else class="cover cover-ph"><text class="bi"></text></view>

  <!-- 基本信息 -->
  <view class="card info-card">
    <view class="name-row">
      <view class="name">{{dish.name}}</view>
      <view class="edit-btn" bindtap="goEdit"><text class="bi"></text> 编辑</view>
    </view>
    <view class="meta">
      <text wx:if="{{categoryName}}" class="chip chip-plain">{{categoryName}}</text>
      <text wx:if="{{priceYuan}}" class="chip">¥{{priceYuan}}</text>
      <text wx:if="{{lastEatenText}}" class="last-eaten">{{lastEatenText}}</text>
    </view>
    <view wx:if="{{sourceInfo}}" class="src-line" bindtap="goSource">
      来源：{{sourceInfo.nickname}} 的公开分享 · 点击查看原菜 ›
    </view>

    <!-- 评分 -->
    <view class="rate-row">
      <text class="rate-label">我的评分</text>
      <view class="stars">
        <text
          wx:for="{{stars}}"
          wx:key="*this"
          class="star {{item <= dish.rating ? 'on' : ''}}"
          data-star="{{item}}"
          bindtap="onRate"
        >★</text>
      </view>
    </view>

    <!-- 状态切换 -->
    <view class="status-row">
      <view
        wx:for="{{statusList}}"
        wx:key="key"
        class="status-btn {{dish.status === item.key ? 'on' : ''}}"
        data-status="{{item.key}}"
        bindtap="onStatusTap"
      ><text class="bi">{{item.icon}}</text> {{item.text}}</view>
    </view>
  </view>

  <!-- 介绍/笔记 -->
  <view class="card" wx:if="{{dish.description}}">
    <view class="section-title">介绍 / 做法笔记</view>
    <view class="desc">{{dish.description}}</view>
  </view>

  <!-- 标签 -->
  <view class="card" wx:if="{{dish.tags.length}}">
    <view class="section-title">标签</view>
    <view>
      <text wx:for="{{dish.tags}}" wx:key="*this" class="chip">{{item}}</text>
    </view>
  </view>

  <!-- 更多图片 -->
  <view class="card" wx:if="{{dish.images.length}}">
    <view class="section-title">图片</view>
    <view class="img-grid">
      <image
        wx:for="{{dish.imagesUrl || dish.images}}"
        wx:key="*this"
        class="grid-img"
        src="{{item}}"
        mode="aspectFill"
        data-url="{{item}}"
        bindtap="previewImage"
        lazy-load
      />
    </view>
  </view>

  </scroll-view>

  <!-- 操作按钮区（固定底部，不随内容滚动） -->
  <view wx:if="{{!isShared}}" class="action-section">
    <!-- 第一行：记一笔 -->
    <button class="btn-primary log-btn" bindtap="onLogEat">
      <text class="bi"></text> 记一笔「今天吃了」
    </button>
    
    <!-- 第二行：生成分享海报 + 分享给好友 -->
    <view class="share-row">
      <button class="btn-ghost share-btn" bindtap="onPoster">
        <text class="bi"></text> 生成分享海报
      </button>
      <button class="btn-ghost share-btn" open-type="share">
        <text class="bi"></text> 分享给好友
      </button>
    </view>
    
    <!-- 第三行：公开发布（灵感广场）状态与入口 -->
    <view class="pub-row">
      <block wx:if="{{!myPub}}">
        <button class="btn-ghost share-btn" bindtap="openPublishSheet">发布到灵感广场</button>
      </block>
      <block wx:elif="{{myPub.reviewStatus === 'pending'}}">
        <view class="pub-status pending">审核中</view>
        <view class="pub-withdraw" bindtap="withdrawPub">撤回</view>
      </block>
      <block wx:elif="{{myPub.reviewStatus === 'approved'}}">
        <view class="pub-status approved">已公开 · {{myPub.likeCount || 0}} 赞</view>
        <view class="pub-withdraw" bindtap="withdrawPub">撤回公开</view>
      </block>
      <block wx:elif="{{myPub.reviewStatus === 'rejected'}}">
        <view class="pub-status rejected">审核未通过</view>
        <view class="pub-withdraw" bindtap="republish">修改后重新提交</view>
      </block>
      <block wx:elif="{{myPub.reviewStatus === 'withdrawn'}}">
        <button class="btn-ghost share-btn" bindtap="openPublishSheet">重新发布到灵感广场</button>
      </block>
    </view>

    <!-- 第四行：删除 -->
    <view class="delete-link" bindtap="onDelete">删除这道菜</view>
  </view>

  <!-- 发布确认弹层：预览公开范围，用户主动确认 -->
  <view wx:if="{{showPublishSheet}}" class="pub-mask" bindtap="closePublishSheet"></view>
  <view wx:if="{{showPublishSheet}}" class="pub-sheet">
    <view class="pub-sheet-title">发布到灵感广场</view>
    <view class="pub-sheet-desc">公开后将进入推荐池，经内容审核后对其他用户可见。请确认公开范围：</view>
    <view class="pub-preview">
      <image wx:if="{{dish.coverImageUrl || dish.coverImage}}" class="pub-preview-img" src="{{dish.coverImageUrl || dish.coverImage}}" mode="aspectFill" />
      <view class="pub-preview-name">{{dish.name}}</view>
      <view class="pub-preview-tags">{{dish.tags}}</view>
    </view>
    <view class="pub-opt" bindtap="togglePubOpt" data-key="includeDescription">
      <text class="pub-check {{pubOpts.includeDescription ? 'on' : ''}}">{{pubOpts.includeDescription ? '✓' : ''}}</text>
      <text>公开介绍 / 做法笔记</text>
    </view>
    <view class="pub-opt" bindtap="togglePubOpt" data-key="includePrice">
      <text class="pub-check {{pubOpts.includePrice ? 'on' : ''}}">{{pubOpts.includePrice ? '✓' : ''}}</text>
      <text>公开价格（默认不公开）</text>
    </view>
    <view wx:if="{{dish.sourcePublicDishId}}" class="pub-derived">
      这道菜保存自灵感广场，发布后将标注「改编自 {{dish.sourceAuthor.nickname || '原作者'}}」
    </view>
    <view class="pub-opt" bindtap="togglePubOpt" data-key="anonymous">
      <text class="pub-check {{pubOpts.anonymous ? 'on' : ''}}">{{pubOpts.anonymous ? '✓' : ''}}</text>
      <text>匿名分享（不显示我的昵称头像）</text>
    </view>
    <button class="btn-primary pub-submit" bindtap="submitPublish">确认发布并送审</button>
  </view>

  <!-- 分享/公开快照：保存到我的菜单；公开模式加点赞行与作者信息 -->
  <view wx:if="{{isShared}}" class="action-section">
    <view wx:if="{{shareMode === 'public'}}" class="public-meta">
      <view class="public-author">{{dish.anonymous ? '匿名厨友' : dish.authorNickname}} 的公开分享</view>
      <view class="like-row" bindtap="onToggleLike">
        <text class="like-heart {{publicLiked ? 'on' : ''}}">{{publicLiked ? '♥' : '♡'}}</text>
        <text class="like-count">{{publicLikeCount}}</text>
      </view>
    </view>
    <view wx:if="{{shareExpired}}" class="expired-hint">链接已过期或内容已撤回</view>
    <button wx:elif="{{shareMode === 'public' && publicSaved}}" class="btn-ghost log-btn" disabled>已加入我的菜单</button>
    <button wx:else class="btn-primary log-btn" bindtap="onCopyToMyMenu">
      <text class="bi"></text> 保存到我的菜单
    </button>
  </view>

  <poster id="poster" dish="{{dish}}" cover-image-url="{{dish.coverImageUrl || ''}}" category-name="{{categoryName}}" />
</view>

<!-- 骨架 -->
<view wx:elif="{{loading}}" class="page" style="padding-top: {{navbarHeight}}px;">
  <view class="skeleton-item" style="height: 300rpx"></view>
  <view class="skeleton-item"><view style="flex:1"><view class="skeleton-line" style="width:50%"></view><view class="skeleton-line" style="width:80%"></view></view></view>
</view>
