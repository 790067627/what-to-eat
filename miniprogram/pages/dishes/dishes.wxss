.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 20rpx 24rpx 0;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  margin-bottom: 16rpx;
}
.search-icon { font-size: 26rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 26rpx; }
.search-placeholder { color: #C9A8B8; }
.search-clear { color: #C9A8B8; font-size: 26rpx; padding: 0 8rpx; }

/* 状态筛选 */
.status-bar { white-space: nowrap; margin-bottom: 16rpx; }
.status-chip {
  display: inline-block;
  background: #fff;
  color: #9C7B8C;
  font-size: 24rpx;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
}
.status-chip.on {
  background: #FF8FB8;
  color: #fff;
  font-weight: 500;
}

/* 主体：侧栏 + 列表 */
.content {
  flex: 1;
  display: flex;
  gap: 20rpx;
  min-height: 0;
  padding-bottom: 150rpx;
}

.side {
  width: 170rpx;
  flex-shrink: 0;
  /* 不被 flex 拉伸：高度随内容自然撑开，max-height 由 JS 动态注入 */
  align-self: flex-start;
  display: flex;
  flex-direction: column;
  background: #FBEFF5;
  border-radius: var(--radius-md);
  padding: 12rpx 8rpx;
  overflow: hidden;
}
/* 内层分类滚动区：仅列表滚动，「全部」不随之移动 */
.side-scroll {
  width: 100%;
}
.side-item {
  font-size: 24rpx;
  color: #9C7B8C;
  padding: 22rpx 10rpx;
  border-radius: 16rpx;
  text-align: center;
  margin-bottom: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.side-item.on {
  background: #fff;
  color: #FF8FB8;
  font-weight: 600;
}

.list { flex: 1; height: 100%; min-width: 0; }

/* 菜品卡片 */
.dish-card { display: flex; gap: 20rpx; padding: 20rpx; }
.dish-img {
  width: 130rpx;
  height: 130rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.dish-img-ph {
  background: #FFEAF2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}
.dish-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.dish-name { font-size: 30rpx; font-weight: 600; margin-bottom: 6rpx; }
.dish-sub { font-size: 22rpx; color: #9C7B8C; margin-bottom: 10rpx; }
.dish-rating { color: #FF9500; }
.dish-tags { margin-top: auto; }
.dish-tags .chip { font-size: 20rpx; padding: 4rpx 14rpx; margin-bottom: 0; margin-right: 8rpx; }

/* 悬浮添加按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB3D1, #FF8FB8);
  color: #fff;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 143, 184, 0.4);
  z-index: 100;
}

/* AI 拍照识别主按钮（空态） */
.btn-ai-main {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  padding: 26rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #A78BFA, #EC6FAE);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(167, 110, 220, 0.35);
}
.btn-ai-main .bi { font-size: 32rpx; }

/* ==================== FAB 添加方式面板（自绘） ==================== */
.fab-mask {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: rgba(40, 20, 30, 0.5);
  display: flex;
  align-items: flex-end;
  backdrop-filter: blur(3px);
}
.fab-sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  animation: fabSheetUp 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}
@keyframes fabSheetUp { from { transform: translateY(100%); } }
.fab-handle {
  width: 64rpx; height: 8rpx; border-radius: 4rpx;
  background: #F0E2E9; margin: 0 auto 24rpx;
}

/* ---- AI 识别卡：渐变 + 发光 + 扫光 + 浮动星点 ---- */
.fab-ai-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #7C5AE0 0%, #A78BFA 45%, #EC6FAE 100%);
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(124, 90, 224, 0.4);
  margin-bottom: 18rpx;
}
.fab-ai-card:active { transform: scale(0.98); }

/* 扫光：斜向高光循环掠过 */
.fab-ai-glow {
  position: absolute;
  top: -60%;
  left: -40%;
  width: 45%;
  height: 220%;
  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.35), transparent);
  transform: rotate(18deg);
  animation: fabSweep 2.8s ease-in-out infinite;
  pointer-events: none;
}
@keyframes fabSweep {
  0% { left: -45%; }
  55%, 100% { left: 130%; }
}

/* 浮动星点：三颗不同节奏的光点 */
.fab-ai-dot {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  pointer-events: none;
  box-shadow: 0 0 12rpx 3rpx rgba(255, 255, 255, 0.5);
}
.fab-ai-dot.d1 { width: 8rpx; height: 8rpx; top: 22rpx; right: 90rpx; animation: fabFloat 2.2s ease-in-out infinite; }
.fab-ai-dot.d2 { width: 6rpx; height: 6rpx; bottom: 26rpx; right: 170rpx; animation: fabFloat 2.8s ease-in-out 0.6s infinite; }
.fab-ai-dot.d3 { width: 10rpx; height: 10rpx; top: 40rpx; right: 250rpx; opacity: 0.6; animation: fabFloat 3.4s ease-in-out 1.1s infinite; }
@keyframes fabFloat {
  0%, 100% { transform: translateY(0); opacity: 0.9; }
  50% { transform: translateY(-14rpx); opacity: 0.4; }
}

/* 图标：白底圆角 + 脉冲光环 */
.fab-ai-icon {
  position: relative;
  width: 88rpx; height: 88rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  z-index: 1;
}
.fab-ai-icon::after {
  content: '';
  position: absolute;
  inset: -6rpx;
  border-radius: 30rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.55);
  animation: fabRing 1.8s ease-out infinite;
}
@keyframes fabRing {
  0% { transform: scale(0.92); opacity: 0.9; }
  100% { transform: scale(1.28); opacity: 0; }
}
.fab-ai-icon .bi { font-size: 44rpx; color: #7C3AED; }

.fab-ai-txt { flex: 1; min-width: 0; z-index: 1; }
.fab-ai-t1 {
  font-size: 32rpx; font-weight: 700; color: #fff;
  display: flex; align-items: center; gap: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(60, 20, 120, 0.3);
}
.fab-ai-badge {
  font-size: 18rpx; padding: 3rpx 12rpx; border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  font-weight: 700; letter-spacing: 2rpx;
}
.fab-ai-t2 {
  font-size: 22rpx; color: rgba(255, 255, 255, 0.88);
  margin-top: 6rpx; line-height: 1.45;
}
.fab-ai-go {
  font-size: 40rpx; color: rgba(255, 255, 255, 0.85);
  flex-shrink: 0; z-index: 1; font-weight: 300;
}

/* ---- 手动添加：素净行，与 AI 卡形成对比 ---- */
.fab-manual {
  display: flex; align-items: center; gap: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: #FBF6F8;
  border: 1rpx solid #F3E6EC;
  margin-bottom: 18rpx;
}
.fab-manual:active { background: #F7EDF1; }
.fab-manual-icon {
  width: 72rpx; height: 72rpx; border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid #F0DDE6;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.fab-manual-icon .bi { font-size: 34rpx; color: #C9A8B8; }
.fab-manual-txt { flex: 1; }
.fab-manual-t1 { font-size: 30rpx; font-weight: 600; color: #4A2C3A; }
.fab-manual-t2 { font-size: 22rpx; color: #C9A8B8; margin-top: 4rpx; }

.fab-cancel {
  height: 96rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 24rpx;
  background: #F7F2F4;
  color: #9C7B8C;
  font-size: 30rpx;
}
.fab-cancel:active { background: #EFE7EB; }
