<page-meta page-style="{{themeVars}}" root-background-color="{{themeWindowBg}}" background-color="{{themeWindowBg}}" background-text-style="{{themeJs.mode === 'dark' ? 'light' : 'dark'}}" />
<!-- 外观设置：三套主题预览卡片，点击即全局切换 -->

<view class="page">
  <view class="page-tip">选择一套外观主题，立即生效并自动记住你的选择。切换只改变视觉，不影响任何菜品数据与记录。</view>

  <view class="theme-list">
    <view
      wx:for="{{themes}}"
      wx:key="name"
      class="theme-card {{item.selected ? 'selected' : ''}}"
      data-name="{{item.name}}"
      bindtap="onSelect"
    >
      <!-- 迷你预览：用该主题自身的色板绘制（非当前主题变量），所见即所得 -->
      <view class="pv" style="background: {{item.preview.bg}};">
        <!-- 顶部条：模拟导航 -->
        <view class="pv-nav" style="background: {{item.preview.accentSoft}};"></view>
        <!-- 卡片行 -->
        <view class="pv-card" style="background: {{item.preview.card}}; border-color: {{item.preview.border}};">
          <view class="pv-thumb" style="background: {{item.preview.accentSoft}};"></view>
          <view class="pv-lines">
            <view class="pv-line" style="background: {{item.preview.text}}; opacity: 0.85;"></view>
            <view class="pv-line short" style="background: {{item.preview.text}}; opacity: 0.4;"></view>
          </view>
        </view>
        <view class="pv-card" style="background: {{item.preview.card}}; border-color: {{item.preview.border}};">
          <view class="pv-thumb" style="background: {{item.preview.accentSoft}};"></view>
          <view class="pv-lines">
            <view class="pv-line" style="background: {{item.preview.text}}; opacity: 0.85;"></view>
            <view class="pv-line short" style="background: {{item.preview.text}}; opacity: 0.4;"></view>
          </view>
        </view>
        <!-- 强调色按钮 + TabBar 模拟 -->
        <view class="pv-accent" style="background: {{item.preview.accent}};"></view>
        <view class="pv-tabbar" style="background: {{item.preview.card}}; border-top-color: {{item.preview.border}};">
          <view class="pv-dot" style="background: {{item.preview.text}}; opacity: 0.35;"></view>
          <view class="pv-dot active" style="background: {{item.preview.accent}};"></view>
          <view class="pv-dot" style="background: {{item.preview.text}}; opacity: 0.35;"></view>
        </view>
      </view>

      <!-- 文字信息 + 选中态 -->
      <view class="theme-meta">
        <view class="theme-name">{{item.label}}</view>
        <view class="theme-desc">{{item.desc}}</view>
      </view>
      <view wx:if="{{item.selected}}" class="theme-check bi"></view>
    </view>
  </view>

  <view class="foot-note">后续将支持「跟随系统」深浅色自动切换</view>
</view>
