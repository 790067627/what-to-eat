page { background: #2a1a24; }
.wrap { padding: 24rpx; }
.card {
  background: rgba(255,255,255,.94); border-radius: 24rpx; padding: 24rpx;
  margin-bottom: 24rpx;
}
.t { font-size: 28rpx; font-weight: 700; color: #4A2C3A; margin-bottom: 8rpx; }
.hint { font-size: 22rpx; color: #9C7B8C; margin-bottom: 16rpx; line-height: 1.5; }
.kv { font-size: 24rpx; color: #4A2C3A; margin-bottom: 6rpx; }
.row { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.mark { font-size: 24rpx; color: #A73568; font-weight: 700; margin-left: 8rpx; }

/* 3D 舞台 */
.stage3d { display: flex; justify-content: center; padding: 20rpx 0; background: #3a2430; border-radius: 16rpx; }
.zone { width: 300rpx; height: 420rpx; perspective: 1100px; }
.inner { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; }
.face {
  position: absolute; inset: 0; border-radius: 24rpx; overflow: hidden;
  backface-visibility: hidden; -webkit-backface-visibility: hidden;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.face.static { position: absolute; }
.back {
  transform: rotateY(180deg);
  background: linear-gradient(160deg,#E85D91,#C74B7C 46%,#8E2F58);
  border: 2rpx solid rgba(255,190,216,.55);
}
.emblem {
  width: 120rpx; height: 120rpx; border-radius: 50%; font-size: 60rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.15); border: 2rpx solid rgba(255,222,236,.65);
}
.front { background: #fff; border: 2rpx solid #FFDEEC; }
.ph { width: 100%; height: 220rpx; background: linear-gradient(135deg,#FFD6E7,#FF8FB8); }
.nm { font-size: 30rpx; font-weight: 700; color: #4A2C3A; margin-top: 16rpx; }
.inner2d { position: relative; width: 100%; height: 100%; }

/* B 对照：CSS 动画翻牌 */
.cssflip.go { animation: cssflip .9s linear forwards; }
@keyframes cssflip {
  0% { transform: rotateY(180deg); }
  100% { transform: rotateY(0deg); }
}

/* D canvas */
.cvbox { position: relative; height: 320rpx; background: #3a2430; border-radius: 16rpx; overflow: hidden; }
.fx { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }

/* E 模糊 */
.blur-row { display: flex; gap: 16rpx; }
.blur-cell { flex: 1; position: relative; border-radius: 12rpx; overflow: hidden; }
.blur-src {
  background: #fff; padding: 28rpx 16rpx; font-size: 26rpx; color: #4A2C3A; text-align: center;
}
.filterblur { filter: blur(6px) brightness(.6); }
.blur-mask {
  position: absolute; inset: 0; background: rgba(60,20,40,.45);
  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
}
.tag { position: absolute; bottom: 4rpx; left: 8rpx; font-size: 20rpx; color: #A73568; background: rgba(255,255,255,.85); padding: 2rpx 10rpx; border-radius: 99rpx; }

.sum { width: 100%; min-height: 160rpx; font-size: 22rpx; background: #F7EDF2; border-radius: 12rpx; padding: 12rpx; margin-bottom: 12rpx; }
.errcard { background: #FFF3D6; border: 2rpx solid #E8B93C; }
